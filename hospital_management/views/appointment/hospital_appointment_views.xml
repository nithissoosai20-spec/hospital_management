<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- APPOINTMENT LIST -->

    <record id="view_hospital_appointment_list" model="ir.ui.view">

        <field name="name">hospital.appointment.list</field>

        <field name="model">hospital.appointment</field>

        <field name="arch" type="xml">

            <list
                class="hospital_appointment_list"
                limit="11"
                delete="false"
                create="false"
                js_class="hospital_appointment_list"
            >

                <!-- HIDDEN / DISABLED COLUMNS -->

                <field
                    name="name"
                    column_invisible="True"
                />

                <field
                    name="transaction_id"
                    column_invisible="True"
                />

                <field
                    name="print_preference"
                    column_invisible="True"
                />

                <field
                    name="receipt_printed"
                    column_invisible="True"
                />

                <!-- REQUIRED APPOINTMENT INFORMATION -->

                <field
                    name="patient_code"
                    string="Patient ID"
                />

                <field
                    name="patient_name"
                    string="Patient Name"
                />

                <field
                    name="patient_phone"
                    string="Contact No."
                />

                <field
                    name="appointment_date"
                    string="Date"
                />

                <field
                    name="token_number"
                    string="Token No."
                />

                <field
                    name="doctor_id"
                    string="Doctor"
                />

                <field
                    name="department_id"
                    string="Department"
                />

                <field
                    name="appointment_time"
                    string="Visit Time"
                    widget="html_time"
                />

                <field
                    name="visit_type"
                    string="Visit Type"
                />

                <field
                    name="consultation_type_id"
                    string="Consultation Type"
                    optional="show"
                />

                <field
                    name="priority"
                    string="Priority"
                />

                <field
                    name="fees_type"
                    string="Fees Type"
                />

                <field
                    name="net_amount"
                    string="Net Amount"
                />

                <field
                    name="payment_status"
                    string="Payment Status"
                />

                <field name="state" string="Status"/>
<field name="has_lab_test" column_invisible="True"/>

                <!-- ACTION BUTTONS -->
                <!-- EYE: Always visible -->
                <button
                    name="action_view_appointment"
                    type="object"
                    icon="fa-eye"
                    title="View"
                    class="hospital_appointment_action btn-sm"
                />

                <!-- PENCIL: Real -->
                <button
                    name="action_edit_appointment"
                    type="object"
                    icon="fa-pencil"
                    title="Edit"
                    invisible="state in ('completed', 'cancelled')"
                    class="hospital_appointment_action btn-sm"
                />
                

                <!-- PRINTER: Real -->
                <button
                    name="action_print_receipt"
                    type="object"
                    icon="fa-print"
                    title="Print Receipt"
                    invisible="state != 'booked'"
                    class="hospital_appointment_action btn-sm"
                />
                

                <!-- FLASK: Real -->
                <button
                    name="action_open_lab_test"
                    type="object"
                    icon="fa-flask"
                    title="Lab Tests"
                    invisible="has_lab_test == False"
                    class="hospital_appointment_action btn-sm text-info"
                />
                
    </list>

        </field>

    </record>


    <!-- APPOINTMENT FORM -->

    <record
        id="view_hospital_appointment_form"
        model="ir.ui.view"
    >

        <field name="name">hospital.appointment.form</field>

        <field name="model">hospital.appointment</field>

        <field name="arch" type="xml">

            <form
                string=""
                class="hospital_appointment_form" js_class="hospital_appointment_form_view"
               
            >

                <!-- CUSTOM PATIENT SEARCH TOOLBAR -->

                <div class="hospital_appointment_search_toolbar">
                  <!-- FIX REQUIRED FIELDS STYLING -->
                  <style>
                      /* Remove red text from labels */
                      .hospital_appointment_form .o_field_invalid label,
                      .hospital_appointment_form label.o_field_invalid,
                      .hospital_appointment_form .o_field_invalid.o_form_label,
                      .hospital_appointment_form .o_field_widget.o_field_invalid {
                          color: #6b7280 !important; /* Default label color */
                      }

                      /* Add pink background and red border to inputs */
                      .hospital_appointment_form .o_field_invalid input,
                      .hospital_appointment_form .o_field_invalid select,
                      .hospital_appointment_form .o_field_invalid textarea {
                          background-color: #fce4e4 !important;
                          border: 1px solid #dc3545 !important;
                      }
                      
                      /* Fix Odoo 16+ adding red borders to the widget wrapper instead of input */
                      .hospital_appointment_form .o_field_widget.o_field_invalid {
                          border: none !important;
                          background-color: transparent !important;
                      }
                  </style>



                    <div class="hospital_appointment_search_box">

                        <!-- SEARCH -->

                        <field
                            name="search_patient"
                            placeholder="Patient ID or Mobile Number"
                            nolabel="1"
                            readonly="context.get('view_only') or state != 'draft'"
                        />

                        <!-- SEARCH BUTTON -->

                        <button
                            name="action_search_patient"
                            string="Search"
                            type="object"
                            class="btn-primary hospital_search_button"
                            icon="fa-search"
                            invisible="context.get('view_only') or state != 'draft'"
                        />

                        
                        <!-- CLEAR -->

                        <button
                            name="action_clear_form"
                            string="Clear"
                            type="object"
                            class="btn-secondary hospital_clear_button"
                            icon="fa-eraser"
                            invisible="context.get('view_only') or state != 'draft'"
                        />

                        <!-- HISTORY (near Clear) -->

                        <button
                            name="action_view_patient_history"
                            string="History"
                            type="object"
                            class="btn-secondary hospital_clear_button"
                            icon="fa-history"
                            invisible="not patient_found"
                        />

                    </div>

                </div>


                <!-- APPOINTMENT SHEET -->

                <sheet class="hospital_appointment_sheet">

                    <!-- TECHNICAL FIELDS -->

                    <field
                        name="state"
                        invisible="1"
                    />

                    <field
                        name="patient_id"
                        invisible="1"
                    />

                    <field
                        name="patient_found"
                        invisible="1"
                    />

                    <field
                        name="token_generated"
                        invisible="1"
                    />

                    <field
                        name="receipt_printed"
                        invisible="1"
                    />

                    <field
                        name="token_printed"
                        invisible="1"
                    />

                    <field
                        name="available_consultation_type_ids"
                        invisible="1"
                    />


                    <!-- HORIZONTAL APPOINTMENT WORKFLOW -->

                    <div class="hospital_appointment_columns">

                        <!-- 1. PATIENT DETAILS -->

                        <div class="hospital_appointment_column hospital_patient_column">

                            <div class="hospital_section_title">
                                Patient Details
                            </div>

                            <!-- EXISTING PATIENT -->

                            <div
                                invisible="not patient_found"
                                class="hospital_patient_found"
                            >

                                <div class="hospital_patient_grid">

                                    <!-- PATIENT ID -->

                                    <div>
                                        <label
                                            for="patient_code"
                                            string="Patient ID"
                                        />

                                        <field
                                            name="patient_code"
                                            readonly="1"
                                            nolabel="1"
                                        />
                                    </div>


                                    <!-- PATIENT NAME -->

                                    <div>
                                        <label
                                            for="patient_name"
                                            string="Patient Name"
                                        />

                                        <field
                                            name="patient_name"
                                            readonly="1"
                                            nolabel="1"
                                        />
                                    </div>


                                    <!-- AGE -->

                                    <div>
                                        <label
                                            for="patient_age"
                                            string="Age"
                                        />

                                        <field
                                            name="patient_age"
                                            readonly="1"
                                            nolabel="1"
                                        />
                                    </div>


                                    <!-- GENDER -->

                                    <div>
                                        <label
                                            for="patient_gender"
                                            string="Gender"
                                        />

                                        <field
                                            name="patient_gender"
                                            readonly="1"
                                            nolabel="1"
                                        />
                                    </div>


                                    <!-- MOBILE -->

                                    <div>
                                        <label
                                            for="patient_phone"
                                            string="Mobile"
                                        />

                                        <field
                                            name="patient_phone"
                                            readonly="1"
                                            nolabel="1"
                                        />
                                    </div>

                                </div>

                            </div>


                            <!-- NEW PATIENT -->

                            <div
                                invisible="patient_found or context.get('view_only')"
                                class="hospital_new_patient"
                            >

                                <div class="hospital_new_patient_grid">

                                    <!-- PATIENT NAME -->

                                    <div>
                                        <label
                                            for="new_patient_name"
                                            string="Patient Name"
                                        />

                                        <field
                                            name="new_patient_name"
                                            nolabel="1"
                                            readonly="context.get('view_only') or state != 'draft'"
                                         />
                                    </div>


                                    <!-- MOBILE -->

                                    <div>
                                        <label
                                            for="new_patient_phone"
                                            string="Mobile"
                                        />

                                        <field
                                            name="new_patient_phone"
                                            nolabel="1"
                                            readonly="context.get('view_only') or state != 'draft'"
                                         />
                                    </div>


                                    <!-- DATE OF BIRTH -->

                                    <div>
                                        <label
                                            for="new_patient_age"
                                            string="Age"
                                        />

                                        <field
                                            name="new_patient_age"
                                            nolabel="1"
                                            readonly="context.get('view_only') or state != 'draft'"
                                         />
                                    </div>


                                    <!-- GENDER -->

                                    <div>
                                        <label
                                            for="new_patient_gender"
                                            string="Gender"
                                        />

                                        <field
                                            name="new_patient_gender"
                                            nolabel="1"
                                            readonly="context.get('view_only') or state != 'draft'"
                                         />
                                    </div>


                                    <!-- BLOOD GROUP -->

                                    <div>
                                        <label
                                            for="new_patient_blood_group"
                                            string="Blood Group"
                                        />

                                        <field
                                            name="new_patient_blood_group"
                                            nolabel="1"
                                            readonly="context.get('view_only') or state != 'draft'"
                                        />
                                    </div>


                                    <!-- EMAIL -->

                                    <div>
                                        <label
                                            for="new_patient_email"
                                            string="Email"
                                        />

                                        <field
                                            name="new_patient_email"
                                            nolabel="1"
                                            readonly="context.get('view_only') or state != 'draft'"
                                        />
                                    </div>

                                </div>


                                <!-- ADDRESS -->

                                <div class="hospital_address_field">

                                    <label
                                        for="new_patient_address"
                                        string="Address"
                                    />

                                    <field
                                        name="new_patient_address"
                                        nolabel="1"
                                        readonly="context.get('view_only') or state != 'draft'"
                                     />

                                </div>

                            </div>

                        </div>


                        <!-- 2. APPOINTMENT DETAILS -->

                        <div class="hospital_appointment_column hospital_appointment_column_middle">

                            <div class="hospital_section_title">
                                Appointment Details
                            </div>


                            <div class="hospital_appointment_grid">

                                <!-- DOCTOR -->

                                <div>
                                    <label
                                        for="doctor_id"
                                        string="Doctor"
                                    />

                                    <field
                                        name="doctor_id"
                                        nolabel="1"
                                        readonly="context.get('view_only') or state != 'draft'"
                                    />
                                </div>


                                <!-- DEPARTMENT -->

                                <div>
                                    <label
                                        for="department_id"
                                        string="Department"
                                    />

                                    <field
                                        name="department_id"
                                        readonly="1"
                                        nolabel="1"
                                    />
                                </div>


                                <!-- APPOINTMENT DATE -->

                                <div>
                                    <label
                                        for="appointment_date"
                                        string="Appointment Date"
                                    />

                                    <field
                                        name="appointment_date"
                                        widget="date"
                                        options="{'format': 'dd/MM/yyyy'}"
                                        readonly="context.get('view_only') or state != 'draft'"
                                    />
                                </div>


                                <!-- APPOINTMENT TIME -->

                                <div>
                                    <label
                                        for="appointment_time"
                                        string="Appointment Time"
                                    />

                                    <field
                                        name="appointment_time"
                                        widget="html_time"
                                        nolabel="1"
                                        readonly="context.get('view_only') or state != 'draft'"
                                    />
                                </div>


                                <!-- VISIT TYPE -->

                                <div>
                                    <label
                                        for="visit_type"
                                        string="Visit Type"
                                    />

                                    <field
                                        name="visit_type"
                                        nolabel="1"
                                        readonly="context.get('view_only') or state != 'draft'"
                                    />
                                </div>


                                <!-- CONSULTATION TYPE -->

                                <div>
                                    <label
                                        for="consultation_type_id"
                                        string="Consultation Type"
                                    />

                                    <field
                                        name="consultation_type_id"
                                        nolabel="1"
                                        placeholder="Select Consultation Type..."
                                        domain="[('id', 'in', available_consultation_type_ids)]"
                                        options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                                        readonly="context.get('view_only') or state != 'draft'"
                                    />
                                </div>


                                <!-- PRIORITY -->

                                <div>
                                    <label
                                        for="priority"
                                        string="Priority"
                                    />

                                    <field
                                        name="priority"
                                        nolabel="1"
                                        readonly="context.get('view_only') or state != 'draft'"
                                    />
                                </div>

                                <!-- APPOINTMENT MODE -->

                                <div>
                                    <label
                                        for="appointment_mode"
                                        string="Appointment Mode"
                                    />

                                    <field
                                        name="appointment_mode"
                                        nolabel="1"
                                        readonly="context.get('view_only') or state != 'draft'"
                                    />
                                </div>


                                <!-- TOKEN NUMBER -->

                                <div class="hospital-token-wrapper" style="grid-column: span 2;">

                                    <div class="hospital-token-label">
                                        🎟 TOKEN NUMBER
                                    </div>

                                    <div class="hospital-token-box">

                                        <field
                                            name="token_number"
                                            readonly="1"
                                            nolabel="1"
                                            class="hospital_token_number"
                                        />

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- 3. FEE & PAYMENT -->

                        <div
                            class="hospital_appointment_column hospital_payment_column"
                            invisible="not token_generated"
                        >

                            <div class="hospital_section_title">
                                Fee &amp; Payment
                            </div>


                            <!-- FEES -->

                            <div class="hospital_payment_group">

                                <div class="hospital_payment_field">

                                    <label
                                        for="consultation_fee"
                                        string="Consultation Fee"
                                    />

                                    <!-- RECEPTIONIST -->

                                    <field
                                        name="consultation_fee"
                                        readonly="1"
                                        nolabel="1"
                                        groups="hospital_management.group_hospital_receptionist"
                                    />

                                    <!-- ADMIN / SUPER ADMIN -->

                                    <field
                                        name="consultation_fee"
                                        nolabel="1"
                                        readonly="context.get('view_only') or state != 'draft'"
                                        groups="hospital_management.group_hospital_admin,hospital_management.group_hospital_super_admin"
                                    />

                                </div>


                                <!-- DISCOUNT -->

                                <div class="hospital_payment_field">

                                    <label
                                        for="discount"
                                        string="Discount"
                                    />

                                    <field
                                        name="discount"
                                        nolabel="1"
                                        readonly="context.get('view_only') or state != 'draft'"
                                    />

                                </div>


                                <!-- NET AMOUNT -->

                                <div class="hospital_payment_field">

                                    <label
                                        for="net_amount"
                                        string="Net Amount"
                                    />

                                    <field
                                        name="net_amount"
                                        readonly="1"
                                        nolabel="1"
                                    />

                                </div>

                            </div>
                            
                            <!-- BOOK BUTTON INSIDE PAYMENT BOX -->
                            <div style="margin-top: 15px; border-top: 1px solid #ddd; padding-top: 10px; text-align: center;">
                                <button name="action_open_cash_wizard" type="object" string=" Book Appointment" class="btn btn-primary w-100" icon="fa-check" style="font-weight: bold; border-radius: 4px;" invisible="state != 'draft' or not token_generated"/>
                                <div class="text-success mt-2" style="font-weight: 500; font-size: 13px;" invisible="state not in ('booked', 'completed')">
                                    <i class="fa fa-check-circle me-1"/> The payment is done successfully. proceed to print receipt or lab fees
                                </div>
                                <field name="total_cash_received" invisible="1"/>
                            </div>

                        </div>

                    </div>

                    <!-- ACTION BUTTONS -->

                    <div class="hospital_action_buttons" style="display:flex; justify-content:flex-end; gap:10px; flex-wrap:wrap;">

                        <!-- CANCEL -->
                        <button
                            name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            icon="fa-times"
                            invisible="context.get('view_only') or state not in ('draft','booked')"
                        />

                        <!-- GENERATE TOKEN -->
                        <button
                            name="action_generate_token"
                            string="Generate Token"
                            type="object"
                            class="btn-primary"
                            icon="fa-ticket"
                            invisible="context.get('view_only') or state not in ('draft','booked') or token_generated"
                        />

                        <!-- LAB FEES -->
                        <button
                            name="action_set_lab_fees"
                            string="Lab Fees"
                            type="object"
                            class="btn-primary"
                            icon="fa-flask"
                            invisible="context.get('view_only') or state not in ('booked', 'completed') or not token_generated"
                        />

                        <!-- PRINT TOKEN -->
                        <button
                            name="action_print_token"
                            string="Print Token"
                            type="object"
                            class="btn-success"
                            icon="fa-ticket"
                            invisible="state not in ('booked','completed') or not token_number"
                        />

                        <!-- PRINT RECEIPT -->
                        <button
                            name="action_print_receipt"
                            string="Print Receipt"
                            type="object"
                            class="btn-success"
                            icon="fa-print"
                            invisible="state not in ('booked','completed') or not token_generated"
                        />

                        <!-- CLOSE -->
                        <button
                            name="action_close_form"
                            type="object"
                            string="Close"
                            class="btn-secondary"
                            icon="fa-arrow-left"
                        />

                    </div>

                </sheet>

            </form>

        </field>

    </record>


    <!-- APPOINTMENT ACTION -->

    <record
        id="action_hospital_appointment"
        model="ir.actions.act_window"
    >
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hospital_appointment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hospital_appointment_form')})]"/>
    </record>


    <!-- CASH WIZARD -->

    <record id="view_hospital_appointment_cash_wizard_form" model="ir.ui.view">
        <field name="name">hospital.appointment.cash.wizard.form</field>
        <field name="model">hospital.appointment</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="Collect Payment" style="padding: 0; background: #f8fafc;">
                <!-- We hide the native modal header using CSS -->
                <style>
                    .modal-header { display: none !important; }
                    .modal-body { padding: 0 !important; }
                </style>

                <!-- CUSTOM HEADER -->
                <div style="background:#1e3a8a; color:white; padding:14px 20px; display:flex; justify-content:space-between; align-items:center;">
                    <h3 style="margin:0; font-size:18px; font-weight:700; color:white;">Collect Payment</h3>
                    <button special="cancel" class="btn btn-link" style="color:white; font-size:22px; font-weight:bold; line-height:1; padding:0; text-decoration:none;"><i class="fa fa-times"/></button>
                </div>

                <div style="padding:20px; background: white;">
                    <!-- TOP INFO -->
                    <div style="display:flex; justify-content:space-between; margin-bottom:15px; border-bottom: 1px solid #e2e8f0; padding-bottom: 15px;">
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <div style="display: flex; align-items: center;">
                                <span style="font-weight:600; color:#334155; display:inline-block; width:160px;">Type of Digital Payment:</span>
                                <field name="payment_mode" nolabel="1" style="display:inline-block; width:120px; border:1px solid #cbd5e1; border-radius:4px; padding:2px; height: 30px;"/>

                                <span style="font-weight:600; color:#334155; margin-left: 20px; margin-right: 10px;">Transaction ID:</span>
                                <field name="transaction_id" nolabel="1" style="display:inline-block; width:150px; border:1px solid #cbd5e1; border-radius:4px; padding:2px; height: 30px;" required="payment_mode != 'none' and payment_mode != False"/>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <span style="font-weight:600; color:#334155; display:inline-block; width:160px;">Online Paid Amount:</span>
                                <field name="online_paid_amount" nolabel="1" style="display:inline-block; width:120px; border:1px solid #cbd5e1; border-radius:4px; padding:2px; height: 30px; text-align:right;" required="payment_mode != 'none' and payment_mode != False"/>
                            </div>
                        </div>
                        <div style="text-align:right;">
                            <span style="font-weight:700; font-size:16px; color:#1e293b;">Net amount: </span>
                            <field name="amount_to_collect" nolabel="1" class="fw-bold text-primary" style="font-size: 24px;" readonly="1" force_save="1"/>
                        </div>
                    </div>

                    <!-- TABLE -->
                    <table style="width:100%; border-collapse:collapse; font-size:14px; text-align:center;">
                        <thead>
                            <tr style="background:#e2e8f0; color:#334155; font-weight:bold;">
                                <th style="border:1px solid #cbd5e1; padding:8px;">Denomination</th>
                                <th style="border:1px solid #cbd5e1; padding:8px;">Received Count</th>
                                <th style="border:1px solid #cbd5e1; padding:8px;">Received Amount</th>
                                <th style="border:1px solid #cbd5e1; padding:8px;">Repay Count</th>
                                <th style="border:1px solid #cbd5e1; padding:8px;">Repay Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- 500 -->
                            <tr>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;">500 X</td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="notes_500" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_500_recv" nolabel="1" readonly="1"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="return_500" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_500_ret" nolabel="1" readonly="1"/></td>
                            </tr>
                            <!-- 200 -->
                            <tr>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;">200 X</td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="notes_200" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_200_recv" nolabel="1" readonly="1"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="return_200" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_200_ret" nolabel="1" readonly="1"/></td>
                            </tr>
                            <!-- 100 -->
                            <tr>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;">100 X</td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="notes_100" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_100_recv" nolabel="1" readonly="1"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="return_100" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_100_ret" nolabel="1" readonly="1"/></td>
                            </tr>
                            <!-- 50 -->
                            <tr>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;">50 X</td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="notes_50" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_50_recv" nolabel="1" readonly="1"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="return_50" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_50_ret" nolabel="1" readonly="1"/></td>
                            </tr>
                            <!-- 20 -->
                            <tr>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;">20 X</td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="notes_20" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_20_recv" nolabel="1" readonly="1"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="return_20" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_20_ret" nolabel="1" readonly="1"/></td>
                            </tr>
                            <!-- 10 -->
                            <tr>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;">10 X</td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="notes_10" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_10_recv" nolabel="1" readonly="1"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="return_10" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="amt_10_ret" nolabel="1" readonly="1"/></td>
                            </tr>
                            <!-- Coins -->
                            <tr>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;" colspan="2">Coins</td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="coins_received" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;"></td>
                                <td style="border:1px solid #cbd5e1; padding:6px;"><field name="coins_return" nolabel="1" class="text-center" style="width:70px;" widget="number_spinner"/></td>
                            </tr>
                            <!-- Totals -->
                            <tr>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;" colspan="2">Total</td>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;"><field name="total_cash_received" nolabel="1" readonly="1"/></td>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;"></td>
                                <td style="border:1px solid #cbd5e1; padding:6px; font-weight:bold;"><field name="total_cash_returned" nolabel="1" readonly="1"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="margin-top: 15px; font-weight: bold;">
                        <div>
                            Balance Amount: <field name="balance_amount" nolabel="1" class="text-danger" readonly="1"/>
                        </div>
                        <div style="margin-top: 5px;">
                            Total Received Payment: <field name="total_cash_received" nolabel="1" class="text-success" readonly="1"/>
                        </div>
                    </div>
                </div>

                <footer style="background:#f8fafc; padding:15px 20px; border-top:1px solid #e2e8f0;">
                    <div class="w-100 d-flex justify-content-end" style="gap: 10px;">
                        <button string="Cancel" class="btn-outline-secondary btn" special="cancel"/>
                        <button string="Hold" name="action_hold_cash" type="object" class="btn-warning btn"/>
                        <button string="Confirm and Pay" name="action_confirm_cash" type="object" class="btn-success btn"/>
                    </div>
                </footer>
            </form>
        </field>
    </record>

</odoo>


