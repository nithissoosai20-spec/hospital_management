<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- DOCTOR'S APPOINTMENT FORM (Clean view) -->
    <record id="view_hospital_appointment_doctor_form" model="ir.ui.view">
        <field name="name">hospital.appointment.doctor.form</field>
        <field name="model">hospital.appointment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Doctor Consultation">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,booked,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_pharmacy_prescriptions" type="object" class="oe_stat_button" icon="fa-medkit">
                            <field name="pharmacy_bill_count" widget="statinfo" string="Medicines"/>
                        </button>
                        <button name="action_open_lab_prescriptions" type="object" class="oe_stat_button" icon="fa-flask">
                            <field name="lab_appointment_count" widget="statinfo" string="Lab Tests"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Patient Information">
                            <field name="patient_id" readonly="1" options="{'no_open': True}"/>
                            <field name="patient_age" readonly="1"/>
                            <field name="patient_gender" readonly="1"/>
                        </group>
                        <group string="Appointment Details">
                            <field name="appointment_date" readonly="1"/>
                            <field name="appointment_time" readonly="1" widget="html_time"/>
                            <field name="visit_type" readonly="1"/>
                            <field name="doctor_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Diagnosis &amp; Notes">
                            <field name="reason" placeholder="Enter diagnosis and consultation notes here..."/>
                        </page>
                    </notebook>

                    <!-- ACTION BUTTONS -->
                    <div style="display: flex; justify-content: flex-end; margin-top: 20px;">
                        <button name="action_complete" type="object" string="Mark as Completed" class="btn-success" icon="fa-check" invisible="state != 'booked'"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- DOCTOR'S ACTIONS -->
    <record id="action_hospital_doctor_appointments" model="ir.actions.act_window">
        <field name="name">My Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doctor_id.odoo_user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hospital_management.view_hospital_appointment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_appointment_doctor_form')})]"/>
    </record>

    <record id="action_hospital_doctor_appointments_today" model="ir.actions.act_window">
        <field name="name">Today's Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doctor_id.odoo_user_id', '=', uid), ('appointment_date', '=', context_today())]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hospital_management.view_hospital_appointment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_appointment_doctor_form')})]"/>
    </record>

    <record id="action_hospital_doctor_appointments_completed" model="ir.actions.act_window">
        <field name="name">Completed Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doctor_id.odoo_user_id', '=', uid), ('state', '=', 'completed'), ('appointment_date', '=', context_today())]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hospital_management.view_hospital_appointment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_appointment_doctor_form')})]"/>
    </record>

    <record id="action_hospital_doctor_appointments_waiting" model="ir.actions.act_window">
        <field name="name">Pending Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doctor_id.odoo_user_id', '=', uid), ('state', 'in', ['draft', 'booked']), ('appointment_date', '=', context_today())]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hospital_management.view_hospital_appointment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_appointment_doctor_form')})]"/>
    </record>

</odoo>
