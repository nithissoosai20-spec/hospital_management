<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="paperformat_hospital_a4" model="report.paperformat">
        <field name="name">Hospital A4</field>
        <field name="format">A4</field>
        <field name="page_width">0</field>
        <field name="page_height">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line">False</field>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking">True</field><field name="dpi">96</field>
    </record>

    <record id="action_report_hospital_appointment_receipt" model="ir.actions.report">
        <field name="name">Appointment Token</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_hospital_a4"/>
        <field name="report_name">hospital_management.report_hospital_appointment_receipt</field>
        <field name="report_file">hospital_management.report_hospital_appointment_receipt</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_hospital_appointment_token" model="ir.actions.report">
        <field name="name">Appointment Receipt</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_hospital_a4"/>
        <field name="report_name">hospital_management.report_hospital_appointment_token</field>
        <field name="report_file">hospital_management.report_hospital_appointment_token</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hospital_appointment_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                
                    <style>
                        .o_report_footer, footer, .o_footer, #wkhtmltopdf-footer, .footer-block { display: none !important; }
                        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                        .patient-info-table,
                        .patient-info-table tr,
                        .patient-info-table td {
                            border: none !important;
                            border-top: none !important;
                            border-bottom: none !important;
                            border-left: none !important;
                            border-right: none !important;
                            outline: none !important;
                            box-shadow: none !important;
                            background: transparent !important;
                        }
                    </style>

                    <div class="article" style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                        <div class="page" style="position: relative; width: 210mm; height: 297mm; min-height: 297mm; overflow: hidden; margin: 0; padding: 0; box-sizing: border-box;">
                            
                            <!-- BACKGROUND & BORDERS -->
                            <div style="position: absolute; top: 3mm; right: 6mm; bottom: 3mm; left: 3mm; width: auto; height: auto; z-index: 0; overflow: hidden;">
                                <img src="/hospital_management/static/src/img/purchase_bg.png" style="display: block; width: 100%; height: 100%; max-width: none; object-fit: fill;"/>
                                
                            </div>

                            <!-- CONTENT WRAPPER -->
                            <div style="position: relative; z-index: 1; padding-top: 75mm; padding-left: 15mm; padding-right: 15mm; padding-bottom: 15mm; height: 100%; overflow: hidden; box-sizing: border-box;">
                                                                <!-- PATIENT DETAILS (3 COLUMNS WITH CLEAN COLON ALIGNMENT, NO TABLE) -->
                                <div class="row pt-2" style="font-size: 12px; color: #333; line-height: 22px;">
                                    <div class="col-4">
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Patient Name</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span><span t-out="doc.get_patient_title_name()"/></span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Mobile Number</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span><span t-field="doc.patient_phone"/></span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Age / Gender</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span>
                                                <t t-if="doc.patient_id and doc.patient_id.age"><span t-field="doc.patient_id.age"/> / </t>
                                                <t t-elif="doc.new_patient_age"><span t-field="doc.new_patient_age"/> / </t>
                                                <t t-if="doc.patient_id and doc.patient_id.gender">
                                                    <span style="text-transform: capitalize;" t-field="doc.patient_id.gender"/>
                                                </t>
                                                <t t-elif="doc.new_patient_gender">
                                                    <span style="text-transform: capitalize;" t-field="doc.new_patient_gender"/>
                                                </t>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Doctor Name</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span><span t-out="doc.get_doctor_title_name()"/></span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Department</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span><span t-field="doc.department_id.name"/></span>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 80px;">Date / Time</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span>
                                                <span t-field="doc.appointment_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                                <span t-out="doc.get_exact_current_time()"/>
                                            </span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 80px;">Patient ID</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span>
                                                <t t-if="doc.patient_id and doc.patient_id.patient_id">
                                                    <span t-field="doc.patient_id.patient_id"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-field="doc.patient_code"/>
                                                </t>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- VITALS TABLE (5 ROWS: BP, SPO2, PR, Temp, RBS) -->
                                <div class="row mt-3">
                                    <div class="col-8"></div>
                                    <div class="col-4">
                                        <table style="width: 140px; margin-left: auto; border-collapse: collapse; border: 1.5px solid #333; font-size: 11px;">
                                            <tr style="height: 24px;">
                                                <td style="border: 1px solid #555; padding: 2px 8px; font-weight: bold; width: 50px; background-color: #f8fafc;">BP</td>
                                                <td style="border: 1px solid #555; width: 90px;"></td>
                                            </tr>
                                            <tr style="height: 24px;">
                                                <td style="border: 1px solid #555; padding: 2px 8px; font-weight: bold; background-color: #f8fafc;">SPO2</td>
                                                <td style="border: 1px solid #555;"></td>
                                            </tr>
                                            <tr style="height: 24px;">
                                                <td style="border: 1px solid #555; padding: 2px 8px; font-weight: bold; background-color: #f8fafc;">PR</td>
                                                <td style="border: 1px solid #555;"></td>
                                            </tr>
                                            <tr style="height: 24px;">
                                                <td style="border: 1px solid #555; padding: 2px 8px; font-weight: bold; background-color: #f8fafc;">Temp</td>
                                                <td style="border: 1px solid #555;"></td>
                                            </tr>
                                            <tr style="height: 24px;">
                                                <td style="border: 1px solid #555; padding: 2px 8px; font-weight: bold; background-color: #f8fafc;">RBS</td>
                                                <td style="border: 1px solid #555;"></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <div class="row mt-4 justify-content-center">
                                    <div class="col-6">
                                        <table class="table table-sm table-bordered text-center" style="border-color: #999;">
                                            <thead style="background-color: #f1f5f9;">
                                                <tr>
                                                    <th>Description</th>
                                                    <th>Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>Consultation Fee</td>
                                                    <td><span t-field="doc.net_amount"/></td>
                                                </tr>
                                                <tr class="fw-bold">
                                                    <td>Total Paid</td>
                                                    <td><span t-field="doc.net_amount"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                
            </t>
        </t>
    </template>

