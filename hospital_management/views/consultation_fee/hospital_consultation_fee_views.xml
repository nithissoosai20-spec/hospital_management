<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- CONSULTATION FEE LIST -->

    <record id="view_hospital_consultation_fee_list"
            model="ir.ui.view">

        <field name="name">hospital.consultation.fee.list</field>
        <field name="model">hospital.consultation.fee</field>

        <field name="arch" type="xml">

            <list limit="14">

                <field name="department_id"/>
                <field name="designation_id"/>
                <field name="amount"/>
                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- CONSULTATION FEE FORM -->

    <record id="view_hospital_consultation_fee_form"
            model="ir.ui.view">

        <field name="name">hospital.consultation.fee.form</field>
        <field name="model">hospital.consultation.fee</field>

        <field name="arch" type="xml">

            <form>
                <sheet>
                    <div style="padding: 20px 40px;">
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title mb-4">
                            <label for="department_id" string="Department" class="oe_edit_only" style="font-weight: bold; color: #1e3a8a;"/>
                            <h1>
                                <field name="department_id" placeholder="Select Department" required="1"/>
                            </h1>
                        </div>

                        <group>
                            <group name="left_details">
                                <field name="designation_id" required="1"/>
                            </group>
                            <group name="right_details">
                                <field name="amount" string="Consultation Fee (Rs.)" required="1"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>

                        <div class="d-flex justify-content-end gap-2 mt-4" style="border-top: 1px solid #e2e8f0; padding-top: 15px;">
                            <button name="action_save" string="Save" type="object" class="btn-primary"/>
                            <button name="action_clear" string="Clear" type="object" class="btn-secondary"/>
                            <button name="action_close" string="Close" type="object" class="btn-danger"/>
                        </div>
                    </div>
                </sheet>
            </form>

        </field>

    </record>


    <!-- ACTION -->

    <record id="action_hospital_consultation_fees"
            model="ir.actions.act_window">

        <field name="name">Consultation Fees</field>

        <field name="res_model">hospital.consultation.fee</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>
