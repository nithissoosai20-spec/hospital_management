<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- CONSULTATION FEE LIST -->

    <record id="view_hospital_consultation_fee_list"
            model="ir.ui.view">

        <field name="name">hospital.consultation.fee.list</field>
        <field name="model">hospital.consultation.fee</field>

        <field name="arch" type="xml">

            <list limit="14">

                <field name="department_id"/>
                <field name="designation_id"/>
                <field name="consultation_type_id"/>
                <field name="doctor_id" optional="show"/>
                <field name="amount"/>
                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- CONSULTATION FEE FORM -->

    <record id="view_hospital_consultation_fee_form"
            model="ir.ui.view">

        <field name="name">hospital.consultation.fee.form</field>
        <field name="model">hospital.consultation.fee</field>

        <field name="arch" type="xml">

            <form>
                <sheet>
                    <div style="padding: 20px 40px;">
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title mb-4">
                            <label for="department_id" string="Department" class="oe_edit_only" style="font-weight: bold; color: #1e3a8a;"/>
                            <h1>
                                <field name="department_id" placeholder="Select Department" required="1"/>
                            </h1>
                        </div>

                        <group>
                            <group name="left_details">
                                <field name="designation_id" required="1"/>
                                <field name="consultation_type_id" placeholder="Select Consultation Type..." options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="doctor_id" placeholder="Optional (Leave blank for all doctors)"/>
                            </group>
                            <group name="right_details">
                                <field name="amount" string="Consultation Fee (Rs.)" required="1"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>

                        <div class="d-flex justify-content-between align-items-center mt-4" style="border-top: 1px solid #e2e8f0; padding-top: 15px;">
                            <div class="d-flex gap-2">
                                <button name="action_close" string="Close" type="object" class="btn-danger"/>
                                <button name="action_clear" string="Clear" type="object" class="btn-secondary"/>
                            </div>
                            <div>
                                <button name="action_save" string="Save" type="object" class="btn-primary"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>

        </field>

    </record>


    <!-- ACTIONS -->

    <record id="action_hospital_consultation_fees"
            model="ir.actions.act_window">

        <field name="name">Consultation Fees</field>

        <field name="res_model">hospital.consultation.fee</field>

        <field name="view_mode">list,form</field>

    </record>

    <!-- CONSULTATION TYPE VIEWS -->

    <record id="view_hospital_consultation_type_list" model="ir.ui.view">
        <field name="name">hospital.consultation.type.list</field>
        <field name="model">hospital.consultation.type</field>
        <field name="arch" type="xml">
            <list string="Consultation Types">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_consultation_type_form" model="ir.ui.view">
        <field name="name">hospital.consultation.type.form</field>
        <field name="model">hospital.consultation.type</field>
        <field name="arch" type="xml">
            <form string="Consultation Type">
                <sheet>
                    <div style="padding: 20px 40px;">
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title mb-4">
                            <label for="name" string="Consultation Type" class="oe_edit_only" style="font-weight: bold; color: #1e3a8a;"/>
                            <h1>
                                <field name="name" placeholder="e.g. General Consultation, Echo/ECG, Follow-up" required="1"/>
                            </h1>
                        </div>

                        <group>
                            <group name="left_details">
                                <field name="code" placeholder="e.g. CNS-01"/>
                            </group>
                            <group name="right_details">
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>

                        <group>
                            <field name="description" placeholder="Brief details about this consultation type..."/>
                        </group>

                        <div class="d-flex justify-content-between align-items-center mt-4" style="border-top: 1px solid #e2e8f0; padding-top: 15px;">
                            <div class="d-flex gap-2">
                                <button name="action_close" string="Close" type="object" class="btn-danger"/>
                                <button name="action_clear" string="Clear" type="object" class="btn-secondary"/>
                            </div>
                            <div>
                                <button name="action_save" string="Save" type="object" class="btn-primary"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_consultation_types" model="ir.actions.act_window">
        <field name="name">Consultation Types</field>
        <field name="res_model">hospital.consultation.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
