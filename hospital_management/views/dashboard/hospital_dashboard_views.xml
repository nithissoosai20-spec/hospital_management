<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ADMIN DASHBOARD -->

    <record id="view_hospital_admin_dashboard_form"
            model="ir.ui.view">

        <field name="name">hospital.admin.dashboard.form</field>
        <field name="model">hospital.admin.dashboard</field>

        <field name="arch" type="xml">

            <form create="0" delete="0" edit="0">

                <sheet style="
                    height:100%;
                    padding:0;
                    margin:0;
                    max-width:100%;
                ">

                    <div class="adb">

    <!--  -->

                        <div class="adb-header">

                            <div>

                                <div class="adb-title">
                                    🏥 Hospital Admin Dashboard
                                </div>

                                <div class="adb-subtitle">
                                    Welcome, Administrator
                                </div>

                            </div>

                            <div class="dropdown adb-date-filter">
                                <button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 7px; color: #64748b; font-weight: 600; padding: 4px 10px; display: flex; align-items: center; gap: 5px;">
                                    <i class="fa fa-calendar" title="Date Filter"></i>
                                    <field name="date_filter" readonly="1" style="margin-bottom: 0; pointer-events: none;"/>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" role="menu" style="border: 1px solid #e2e8f0; border-radius: 7px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); padding: 5px;">
                                    <li><button name="action_filter_today" type="object" string="Today" class="dropdown-item" style="font-size: 12px; font-weight: 500; border-radius: 4px;"/></li>
                                    <li><button name="action_filter_weekly" type="object" string="Weekly" class="dropdown-item" style="font-size: 12px; font-weight: 500; border-radius: 4px;"/></li>
                                    <li><button name="action_filter_monthly" type="object" string="Monthly" class="dropdown-item" style="font-size: 12px; font-weight: 500; border-radius: 4px;"/></li>
                                    <li><button name="action_filter_q1" type="object" string="Quarter-1 (Jan to Mar)" class="dropdown-item" style="font-size: 12px; font-weight: 500; border-radius: 4px;"/></li>
                                    <li><button name="action_filter_q2" type="object" string="Quarter-2 (April to June)" class="dropdown-item" style="font-size: 12px; font-weight: 500; border-radius: 4px;"/></li>
                                    <li><button name="action_filter_q3" type="object" string="Quarter-3 (July to Sept)" class="dropdown-item" style="font-size: 12px; font-weight: 500; border-radius: 4px;"/></li>
                                    <li><button name="action_filter_q4" type="object" string="Quarter-4 (Oct to Dec)" class="dropdown-item" style="font-size: 12px; font-weight: 500; border-radius: 4px;"/></li>
                                    <li><button name="action_filter_year" type="object" string="Yearly" class="dropdown-item" style="font-size: 12px; font-weight: 500; border-radius: 4px;"/></li>
                                </ul>
                            </div>

                        </div>


    <!--  -->

                        <div class="adb-kpi-row">

                            <!-- USERS -->

                            <button
                                name="%(action_hospital_users)d"
                                type="action"
                                class="adb-kpi adb-blue"
                            >

                                <span class="adb-kpi-icon">👥</span>

                                <span class="adb-kpi-number">
                                    <field
                                        name="total_users"
                                        nolabel="1"
                                        readonly="1"
                                    />
                                </span>

                                <span class="adb-kpi-label">
                                    Total Users
                                </span>

                            </button>


                            <!-- PATIENTS -->

                            <button
                                name="%(action_hospital_patient)d"
                                type="action"
                                class="adb-kpi adb-green"
                            >

                                <span class="adb-kpi-icon">🧑‍⚕️</span>

                                <span class="adb-kpi-number">
                                    <field
                                        name="patient_count"
                                        nolabel="1"
                                        readonly="1"
                                    />
                                </span>

                                <span class="adb-kpi-label">
                                    Total Patients
                                </span>

                            </button>


                            <!-- APPOINTMENTS -->

                            <button
                                name="%(action_hospital_appointment_today)d"
                                type="action"
                                class="adb-kpi adb-purple"
                            >

                                <span class="adb-kpi-icon">📅</span>

                                <span class="adb-kpi-number">
                                    <field
                                        name="appointment_count"
                                        nolabel="1"
                                        readonly="1"
                                    />
                                </span>

                                <span class="adb-kpi-label">
                                    Total Appointments
                                </span>

                            </button>


                            <!-- TODAY APPOINTMENTS -->

                            <button
                                name="%(action_hospital_appointment_today)d"
                                type="action"
                                class="adb-kpi adb-orange"
                            >

                                <span class="adb-kpi-icon">🗓️</span>

                                <span class="adb-kpi-number">
                                    <field
                                        name="today_appointments"
                                        nolabel="1"
                                        readonly="1"
                                    />
                                </span>

                                <span class="adb-kpi-label">
                                    Today's Appointments
                                </span>

                            </button>


                            <!-- TOKENS -->

                            



                            <!-- TOKENS -->

                            <button
                                name="%(action_hospital_token_patients_today)d"
                                type="action"
                                class="adb-kpi adb-cyan"
                            >

                                <span class="adb-kpi-icon">&#127915;</span>

                                <span class="adb-kpi-number">
                                    <field
                                        name="today_token_patients"
                                        nolabel="1"
                                        readonly="1"
                                    />
                                </span>

                                <span class="adb-kpi-label">
                                    Today's Tokens
                                </span>

                            </button>


                            <!-- LAB -->

                            <button
                                name="%(action_hospital_lab_appointments)d"
                                type="action"
                                class="adb-kpi adb-red"
                                context="{
                                    'search_default_appointment_date':
                                    context_today()
                                }"
                            >

                                <span class="adb-kpi-icon">&#128300;</span>

                                <span class="adb-kpi-number">
                                    <field
                                        name="today_lab_tests"
                                        nolabel="1"
                                        readonly="1"
                                    />
                                </span>

                                <span class="adb-kpi-label">
                                    Today's Lab Tests
                                </span>

                            </button>

                        </div>


    <!--  -->

                        <div class="adb-main-row">


                            <!-- STAFF SUMMARY -->

                            <div class="adb-panel">

                                <div class="adb-panel-header">
                                    👥 Staff Summary
                                </div>

                                <div class="adb-list">

                                    <div class="adb-list-row">

                                        <span class="adb-status-dot adb-green-dot"></span>

                                        <span class="adb-list-label">
                                            Active Users
                                        </span>

                                        <strong class="adb-list-number">
                                            <field
                                                name="active_users"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </strong>

                                    </div>


                                    <div class="adb-list-row">

                                        <span class="adb-status-dot adb-red-dot"></span>

                                        <span class="adb-list-label">
                                            Inactive Users
                                        </span>

                                        <strong class="adb-list-number">
                                            <field
                                                name="inactive_users"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </strong>

                                    </div>


                                    <div class="adb-list-row">

                                        <span class="adb-status-dot adb-purple-dot"></span>

                                        <span class="adb-list-label">
                                            Super Admins
                                        </span>

                                        <strong class="adb-list-number">
                                            <field
                                                name="super_admin_count"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </strong>

                                    </div>


                                    <div class="adb-list-row">

                                        <span class="adb-status-dot adb-blue-dot"></span>

                                        <span class="adb-list-label">
                                            Doctors
                                        </span>

                                        <strong class="adb-list-number">
                                            <field
                                                name="doctor_count"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </strong>

                                    </div>


                                    <div class="adb-list-row">

                                        <span class="adb-status-dot adb-orange-dot"></span>

                                        <span class="adb-list-label">
                                            Receptionists
                                        </span>

                                        <strong class="adb-list-number">
                                            <field
                                                name="receptionist_count"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <!-- TODAY ACTIVITY -->

                            <div class="adb-panel">

                                <div class="adb-panel-header">
                                    📊 Today's Activity
                                </div>

                                <div class="adb-activity">

                                    <div class="adb-activity-box">

                                        <span class="adb-activity-number">
                                            <field
                                                name="today_patients"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </span>

                                        <span class="adb-activity-label">
                                            New Patients
                                        </span>

                                    </div>


                                    <div class="adb-activity-box">

                                        <span class="adb-activity-number">
                                            <field
                                                name="today_appointments"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </span>

                                        <span class="adb-activity-label">
                                            Appointments
                                        </span>

                                    </div>


                                    <div class="adb-activity-box">

                                        <span class="adb-activity-number">
                                            <field
                                                name="today_token_patients"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </span>

                                        <span class="adb-activity-label">
                                            Tokens
                                        </span>

                                    </div>


                                    <div class="adb-activity-box">

                                        <span class="adb-activity-number">
                                            <field
                                                name="today_lab_tests"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </span>

                                        <span class="adb-activity-label">
                                            Lab Tests
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- REVENUE -->

                            <div class="adb-panel">

                                <div class="adb-panel-header">
                                    💰 Revenue
                                </div>

                                <div class="adb-revenue">

                                    <div class="adb-revenue-row">

                                        <span>
                                            Consultation
                                        </span>

                                        <strong>
                                            ₹
                                            <field
                                                name="consultation_revenue"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </strong>

                                    </div>


                                    <div class="adb-revenue-row">

                                        <span>Lab Fees</span>

                                        <strong>
                                            ₹
                                            <field
                                                name="lab_revenue"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </strong>

                                    </div>


                                    
                                    <div class="adb-revenue-row">
                                        <span>Pharmacy Collection</span>
                                        <strong>
                                            &#8377;
                                            <field name="pharmacy_collection" nolabel="1" readonly="1"/>
                                        </strong>
                                    </div>
                                    <div class="adb-revenue-total">

                                        <span>
                                            Total Revenue
                                        </span>

                                        <strong>
                                            ₹
                                            <field
                                                name="total_revenue"
                                                nolabel="1"
                                                readonly="1"
                                            />
                                        </strong>

                                    </div>

                                </div>

                            </div>

                            <!-- PAYMENTS (Pharmacy) -->
                            <div class="adb-panel">
                                <div class="adb-panel-header">
                                    <i class="fa fa-money"></i> Pharmacy Payments
                                </div>
                                <div class="adb-revenue">
                                    <div class="adb-revenue-row">
                                        <span>Pending Payments</span>
                                        <strong>
                                            &#8377;
                                            <field name="pharmacy_pending_payments" nolabel="1" readonly="1"/>
                                        </strong>
                                    </div>
                                    <div class="adb-revenue-row">
                                        <span>Settled Payment</span>
                                        <strong>
                                            &#8377;
                                            <field name="pharmacy_paid_payments" nolabel="1" readonly="1"/>
                                        </strong>
                                    </div>
                                    <div class="adb-revenue-row">
                                        <span>Upcoming Payments</span>
                                        <strong>
                                            &#8377;
                                            <field name="pharmacy_upcoming_payments" nolabel="1" readonly="1"/>
                                        </strong>
                                    </div>
                                </div>
                            </div>

                            <!-- STOCK SUMMARY -->
                            <div class="adb-panel">
                                <div class="adb-panel-header">
                                    <i class="fa fa-cubes"></i> Stock
                                </div>
                                <div class="adb-list">
                                    <div class="adb-list-row">
                                        <div class="adb-status-dot adb-blue-dot"></div>
                                        <span class="adb-list-label">Total Medicines</span>
                                        <span class="adb-list-number"><field name="stock_total" nolabel="1" readonly="1"/></span>
                                    </div>
                                    <div class="adb-list-row">
                                        <div class="adb-status-dot adb-orange-dot"></div>
                                        <span class="adb-list-label">Low Stock</span>
                                        <span class="adb-list-number"><field name="stock_low" nolabel="1" readonly="1"/></span>
                                    </div>
                                    <div class="adb-list-row">
                                        <div class="adb-status-dot adb-red-dot"></div>
                                        <span class="adb-list-label">Out of Stock</span>
                                        <span class="adb-list-number"><field name="stock_out" nolabel="1" readonly="1"/></span>
                                    </div>
                                    <div class="adb-list-row">
                                        <div class="adb-status-dot adb-purple-dot"></div>
                                        <span class="adb-list-label">Expired</span>
                                        <span class="adb-list-number"><field name="stock_expired" nolabel="1" readonly="1"/></span>
                                    </div>
                                </div>
                            </div>


                        </div>


    <!--  -->

                        <div class="adb-quick-wrap">
                        <div class="adb-section-title">
                            Quick Actions
                        </div>


                        <div class="adb-actions">


                            <button
                                name="action_create_user"
                                type="object"
                                class="adb-action"
                            >

                                <span class="adb-action-icon">👥</span>

                                <strong>Users</strong>

                                <span>Manage users</span>

                            </button>


                            <button
                                name="%(action_hospital_patient)d"
                                type="action"
                                class="adb-action"
                            >

                                <span class="adb-action-icon">🧑‍⚕️</span>

                                <strong>Patients</strong>

                                <span>Patient records</span>

                            </button>


                            <button
                                name="%(action_hospital_appointment_today)d"
                                type="action"
                                class="adb-action"
                            >

                                <span class="adb-action-icon">📅</span>

                                <strong>Appointments</strong>

                                <span>Today's list</span>

                            </button>


                            


                            


                            


                        </div>
                        </div>
                    </div>

                </sheet>

            </form>

        </field>

    </record>


   

    <!-- ADMIN DASHBOARD RECORD -->

    <record id="admin_dashboard_record"
            model="hospital.admin.dashboard">

        <field name="name">Admin Dashboard</field>

    </record>


    <!-- ADMIN DASHBOARD ACTION -->

    <record id="action_hospital_admin_dashboard_window"
            model="ir.actions.act_window">

        <field name="name">Hospital Dashboard</field>

        <field name="res_model">hospital.admin.dashboard</field>

        <field name="view_mode">form</field>

        <field name="res_id" ref="admin_dashboard_record"/>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>

        <field name="view_id"
               ref="view_hospital_admin_dashboard_form"/>

        <field name="target">current</field>

    </record>

    <!-- DASHBOARD ROUTER (SERVER ACTION) Intercepts action_hospital_dashboard calls from old URLs and intelligently routes users to their correct dashboard without throwing Access Errors. -->

    <record id="action_hospital_dashboard" model="ir.actions.server">
        <field name="name">Hospital Dashboard Router</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="state">code</field>
        <field name="code">
if env.user.has_group('hospital_management.group_hospital_super_admin') or env.user.has_group('hospital_management.group_hospital_admin'):
    action = env.ref('hospital_management.action_hospital_admin_dashboard_window').sudo().read()[0]
    action['context'] = {'form_view_initial_mode': 'edit'}
elif env.user.has_group('hospital_management.group_hospital_receptionist'):
    action = env.ref('hospital_management.action_hospital_reception_dashboard').sudo().read()[0]
elif env.user.has_group('hospital_management.group_hospital_doctor'):
    action = env.ref('hospital_management.action_hospital_doctor_dashboard').sudo().read()[0]
elif env.user.has_group('hospital_management.group_hospital_lab_technician'):
    action = env.ref('hospital_management.action_hospital_lab_dashboard').sudo().read()[0]
elif env.user.has_group('hospital_management.group_hospital_pharmacist'):
    action = env.ref('hospital_management.action_hospital_pharmacy_dashboard_form').sudo().read()[0]
elif env.user.has_group('hospital_hr_asset.group_hospital_asset_manager'):
    action = env.ref('maintenance.hr_equipment_action').sudo().read()[0]
elif env.user.has_group('hospital_management.group_hospital_hr'):
    action = env.ref('hospital_management.action_hospital_hr_dashboard').sudo().read()[0]
else:
    # Fallback
    action = env.ref('hospital_management.action_hospital_admin_dashboard_window').sudo().read()[0]
        </field>
    </record>

</odoo>