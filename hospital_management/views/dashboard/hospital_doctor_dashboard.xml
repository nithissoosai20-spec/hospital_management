<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Doctor's Pending Queue List View -->
    <record id="view_hospital_doctor_patients_queue_list" model="ir.ui.view">
        <field name="name">hospital.doctor.patients.queue.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list string="My Patients Queue">
                <field name="patient_code" string="Patient ID"/>
                <field name="patient_name" string="Full Name"/>
                <field name="patient_gender" string="Gender"/>
                <field name="patient_age" string="Age"/>
                <field name="patient_phone" string="Phone"/>
                <field name="patient_blood_group" string="Blood Group"/>
                <field name="patient_active" string="Active"/>
            </list>
        </field>
    </record>

    <!-- Doctor's Pending Queue Action -->
    
    <!-- Doctor's Pending Queue List View -->
    <record id="view_hospital_doctor_queue_patient_list" model="ir.ui.view">
        <field name="name">hospital.doctor.queue.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list string="My Patients Queue" default_order="last_appointment_time desc">
                <field name="patient_id" string="Patient ID"/>
                <field name="name" string="Full Name"/>
                <field name="gender" string="Gender"/>
                <field name="age" string="Age"/>
                <field name="phone" string="Phone"/>
                <field name="blood_group" string="Blood Group"/>
                <field name="active" string="Active"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_doctor_patients_queue" model="ir.actions.act_window">
        <field name="name">My Patients Queue</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('appointment_ids.state', 'in', ('draft', 'booked')), ('appointment_ids.doctor_id.odoo_user_id', '=', uid)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hospital_management.view_hospital_doctor_queue_patient_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_patient_form')})]"/>
    </record>

    <record id="view_hospital_doctor_dashboard_form" model="ir.ui.view">
        <field name="name">hospital.doctor.dashboard.form</field>
        <field name="model">hospital.doctor.dashboard</field>
        <field name="arch" type="xml">

            <form create="0" edit="0" delete="0">
                <sheet style="height:100%;padding:0;margin:0;max-width:100%;">

                    <div class="ddb">

                        <!-- HEADER -->
                        <div class="ddb-header">
                            <div class="ddb-header-left">
                                <span class="ddb-title">👨‍⚕️ Doctor Dashboard</span>
                                <span class="ddb-subtitle">Welcome, Doctor</span>
                            </div>
                        </div>

                        <!-- STAFF SELF-SERVICE (Attendance / Leave / Expense) -->
                        <div class="ddb-self-service" style="background: #ffffff; border-radius: 12px; padding: 16px 20px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); border: 1px solid #e2e8f0;">
                            <field name="my_attendance_state" invisible="1"/>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                                        <i class="fa fa-id-badge" title="Self Service"></i>
                                    </div>
                                    <div>
                                        <div style="font-weight: 700; font-size: 15px; color: #1e293b;">Staff Self-Service Portal</div>
                                        <div style="font-size: 12px; color: #64748b;">Clock in/out, request leaves, and submit expense claims</div>
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span invisible="my_attendance_state != 'checked_in'" class="badge rounded-pill" style="background-color: #dcfce7; color: #15803d; font-size: 12px; padding: 6px 14px; font-weight: 600; border: 1px solid #bbf7d0;">
                                        <i class="fa fa-circle text-success me-1"></i> Checked In <field name="my_check_in_time" readonly="1" invisible="not my_check_in_time"/>
                                    </span>
                                    <span invisible="my_attendance_state == 'checked_in'" class="badge rounded-pill" style="background-color: #f1f5f9; color: #64748b; font-size: 12px; padding: 6px 14px; font-weight: 600; border: 1px solid #e2e8f0;">
                                        <i class="fa fa-circle-o text-muted me-1"></i> Checked Out
                                    </span>
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
                                <button name="action_toggle_attendance" type="object" class="btn" style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px 14px; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 13px; font-weight: 600; color: #1e293b;">
                                    <i class="fa fa-clock-o text-primary" style="font-size: 16px;" title="Attendance"></i>
                                    <span invisible="my_attendance_state == 'checked_in'">Clock In (Check In)</span>
                                    <span invisible="my_attendance_state != 'checked_in'">Clock Out (Check Out)</span>
                                </button>
                                <button name="action_request_leave" type="object" class="btn" style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px 14px; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 13px; font-weight: 600; color: #1e293b;">
                                    <i class="fa fa-calendar-plus-o text-info" style="font-size: 16px;" title="Leave"></i>
                                    <span>Apply for Leave</span>
                                </button>
                                <button name="action_submit_expense" type="object" class="btn" style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px 14px; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 13px; font-weight: 600; color: #1e293b;">
                                    <i class="fa fa-file-text-o text-warning" style="font-size: 16px;" title="Expense"></i>
                                    <span>Submit Expense</span>
                                </button>
                            </div>
                        </div>

                        <!-- ROW 1 : 5 KPI TILES -->
                        <div class="ddb-row1">

                            <button name="%(action_hospital_appointment)d" type="action" class="ddb-tile">
                                <span class="ddb-tile-icon">📋</span>
                                <span class="ddb-tile-num"><field name="my_appointments" nolabel="1" readonly="1"/></span>
                                <span class="ddb-tile-lbl">My Appointments</span>
                            </button>

                            <button name="%(action_hospital_appointment_today)d" type="action" class="ddb-tile">
                                <span class="ddb-tile-icon">📅</span>
                                <span class="ddb-tile-num"><field name="today_appointments" nolabel="1" readonly="1"/></span>
                                <span class="ddb-tile-lbl">Today's Appointments</span>
                            </button>

                            <button name="%(action_hospital_appointment_completed)d" type="action" class="ddb-tile">
                                <span class="ddb-tile-icon">✅</span>
                                <span class="ddb-tile-num"><field name="completed_appointments" nolabel="1" readonly="1"/></span>
                                <span class="ddb-tile-lbl">Completed</span>
                            </button>

                            <button name="%(action_hospital_appointment_waiting)d" type="action" class="ddb-tile">
                                <span class="ddb-tile-icon">⏳</span>
                                <span class="ddb-tile-num"><field name="pending_appointments" nolabel="1" readonly="1"/></span>
                                <span class="ddb-tile-lbl">Pending</span>
                            </button>

                            <button name="%(action_hospital_doctor_patients_queue)d" type="action" class="ddb-tile">
                                <span class="ddb-tile-icon">🧑‍⚕️</span>
                                <span class="ddb-tile-num"><field name="my_patients" nolabel="1" readonly="1"/></span>
                                <span class="ddb-tile-lbl">My Patients</span>
                            </button>

                        </div>

                        <!-- ROW 2 : APPOINTMENT STATUS + MY PATIENTS + TODAY SUMMARY -->
                        <div class="ddb-row2">

                            <!-- APPOINTMENT STATUS -->
                            <div class="ddb-panel">
                                <div class="ddb-panel-hdr">📋 Appointment Status</div>
                                <div class="ddb-status-grid">

                                    <button name="%(action_hospital_appointment)d" type="action" class="ddb-status-tile ddb-s-blue">
                                        <span class="ddb-s-num"><field name="my_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="ddb-s-lbl">Total</span>
                                    </button>

                                    <button name="%(action_hospital_appointment_today)d" type="action" class="ddb-status-tile ddb-s-green">
                                        <span class="ddb-s-num"><field name="today_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="ddb-s-lbl">Today</span>
                                    </button>

                                    <button name="%(action_hospital_appointment_completed)d" type="action" class="ddb-status-tile ddb-s-purple">
                                        <span class="ddb-s-num"><field name="completed_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="ddb-s-lbl">Completed</span>
                                    </button>

                                    <button name="%(action_hospital_appointment_waiting)d" type="action" class="ddb-status-tile ddb-s-orange">
                                        <span class="ddb-s-num"><field name="pending_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="ddb-s-lbl">Pending</span>
                                    </button>

                                </div>
                            </div>

                            <!-- MY PATIENTS -->
                            <div class="ddb-panel">
                                <div class="ddb-panel-hdr">🧑‍⚕️ My Patients</div>
                                <div class="ddb-patient-body">
                                    <div class="ddb-patient-stats">
                                        <div class="ddb-pstat">
                                            <span class="ddb-pstat-num"><field name="my_patients" nolabel="1" readonly="1"/></span>
                                            <span class="ddb-pstat-lbl">Total</span>
                                        </div>
                                        <div class="ddb-pstat">
                                            <span class="ddb-pstat-num"><field name="today_appointments" nolabel="1" readonly="1"/></span>
                                            <span class="ddb-pstat-lbl">Today</span>
                                        </div>
                                    </div>
                                    <button name="%(action_hospital_doctor_patients_queue)d" type="action" class="ddb-open-btn">
                                        Open Patients →
                                    </button>
                                </div>
                            </div>

                            <!-- TODAY SUMMARY -->
                            <div class="ddb-panel">
                                <div class="ddb-panel-hdr">📊 Today's Summary</div>
                                <div class="ddb-summary-body">

                                    <div class="ddb-summary-box">
                                        <span class="ddb-summary-num"><field name="today_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="ddb-summary-lbl">Appointments</span>
                                    </div>

                                    <div class="ddb-summary-box">
                                        <span class="ddb-summary-num"><field name="completed_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="ddb-summary-lbl">Completed</span>
                                    </div>

                                    <div class="ddb-summary-box">
                                        <span class="ddb-summary-num"><field name="pending_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="ddb-summary-lbl">Pending</span>
                                    </div>

                                    <div class="ddb-summary-box">
                                        <span class="ddb-summary-num"><field name="my_patients" nolabel="1" readonly="1"/></span>
                                        <span class="ddb-summary-lbl">Patients</span>
                                    </div>

                                </div>
                            </div>

                        </div>

                        </div>

                </sheet>
            </form>

        </field>
    </record>


    <!-- Doctor Dashboard Record -->
    <record id="doctor_dashboard_record" model="hospital.doctor.dashboard">
        <field name="name">Doctor Dashboard</field>
    </record>

    <!-- Doctor Dashboard Action -->
    <record id="action_hospital_doctor_dashboard" model="ir.actions.act_window">
        <field name="name">Doctor Dashboard</field>
        <field name="res_model">hospital.doctor.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="doctor_dashboard_record"/>
        <field name="target">current</field>
        <field name="view_id" ref="view_hospital_doctor_dashboard_form"/>
    </record>

</odoo>
