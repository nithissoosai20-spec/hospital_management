        name="Hospital"
        sequence="10"
        groups="hospital_management.group_hospital_user"
        web_icon="hospital_management,static/description/icon.png"
    />


    <!-- ADMIN DASHBOARD -->
    <!-- ADMIN + SUPER ADMIN -->

    <menuitem
        id="menu_hospital_dashboard"
        name="Dashboard"
        parent="menu_hospital_management"
        action="action_hospital_dashboard"
        sequence="10"
        groups="hospital_management.group_hospital_admin,hospital_management.group_hospital_super_admin"
    />


    <!-- RECEPTION DASHBOARD -->
    <!-- RECEPTIONIST ONLY -->

    <menuitem
        id="menu_hospital_dashboard_reception"
        name="Dashboard"
        parent="menu_hospital_management"
        action="action_hospital_reception_dashboard"
        sequence="10"
        groups="hospital_management.group_hospital_receptionist"
    />


    <!-- DOCTOR DASHBOARD -->
    <!-- DOCTOR ONLY -->

        <menuitem
        id="menu_hospital_dashboard_lab_tech"
        name="Dashboard"
        parent="menu_hospital_management"
        action="action_hospital_lab_dashboard"
        sequence="10"
        groups="hospital_management.group_hospital_lab_technician"
    />

    <menuitem
        id="menu_hospital_dashboard_doctor"
        name="Dashboard"
        parent="menu_hospital_management"
        action="action_hospital_doctor_dashboard"
        sequence="10"
        groups="hospital_management.group_hospital_doctor"
    />


    <!-- USERS -->
    <!-- ADMIN + SUPER ADMIN -->

    <menuitem
        id="menu_hospital_users"
        name="Users"
        parent="menu_hospital_management"
        action="action_hospital_users"
        sequence="20"
        groups="hospital_management.group_hospital_admin,hospital_management.group_hospital_super_admin"
    />


    <!-- USER ACTIVITIES -->
    <!-- SUPER ADMIN ONLY -->

    <menuitem
        id="menu_hospital_user_activity"
