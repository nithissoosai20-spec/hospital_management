    <menuitem
        id="menu_hospital_appointments"
        name="Appointment Booking"
        parent="menu_hospital_management"
        action="action_hospital_appointment"
        sequence="40"
        groups="hospital_management.group_hospital_super_admin,hospital_management.group_hospital_receptionist"
    />


    


    

    



    
    <!-- LAB REPORT DIRECT MENU (LAB TECH ONLY) -->
    <menuitem
        id="menu_hospital_lab_report_root"
        name="Lab Report"
        parent="menu_hospital_management"
        action="action_hospital_lab_technician_appointments"
        sequence="55"
        groups="hospital_management.group_hospital_lab_technician"
    />


    <!-- PHARMACY -->

    <menuitem
        id="menu_hospital_pharmacy_dashboard"
        name="Dashboard"
        parent="menu_hospital_management"
        action="action_hospital_pharmacy_dashboard_form"
        sequence="10"
        groups="hospital_management.group_hospital_pharmacist"
    />


    <menuitem
        id="menu_hospital_pharmacy_billing"
        name="Billing"
        parent="menu_hospital_management"
        action="action_hospital_pharmacy_bill_window"
        sequence="20"
        groups="hospital_management.group_hospital_pharmacist"
    />


    <record id="menu_hospital_pharmacy_purchase_root" model="ir.ui.menu">
        <field name="name">Purchase Orders</field>
        <field name="parent_id" ref="menu_hospital_management"/>
        <field name="action" ref="action_hospital_pharmacy_purchase_list_new"/>
        <field name="sequence">50</field>
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('hospital_management.group_hospital_admin'), ref('hospital_management.group_hospital_super_admin')])]"/>
    </record>

    <record id="menu_hospital_pharmacy_payment" model="ir.ui.menu">
        <field name="name">Payments</field>
        <field name="parent_id" ref="menu_hospital_management"/>
        <field name="action" ref="action_hospital_pharmacy_payment"/>
        <field name="sequence">65</field>
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('hospital_management.group_hospital_admin'), ref('hospital_management.group_hospital_super_admin')])]"/>
    </record>

    <record id="menu_hospital_pharmacy_purchase_invoice" model="ir.ui.menu">
        <field name="name">Purchase Invoices</field>
        <field name="parent_id" ref="menu_hospital_management"/>
        <field name="action" ref="action_hospital_pharmacy_purchase_invoice_new"/>
        <field name="sequence">60</field>
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('hospital_management.group_hospital_admin'), ref('hospital_management.group_hospital_super_admin')])]"/>
    </record>
        
    <record id="menu_hospital_purchase_intent_root" model="ir.ui.menu">
        <field name="name">Purchase Intent</field>
        <field name="parent_id" ref="menu_hospital_management"/>
        <field name="action" ref="action_hospital_purchase_intent_new"/>
        <field name="sequence">40</field>
        <field name="active" eval="False"/>
        <field name="group_ids" eval="[(6, 0, [ref('hospital_management.group_hospital_admin'), ref('hospital_management.group_hospital_super_admin')])]"/>
    </record>

    <menuitem 
        id="menu_hospital_pharmacy_category" 
        name="Category" 
        parent="menu_hospital_management" 
        action="action_hospital_pharmacy_category" 
        sequence="25"
        groups="hospital_management.group_hospital_pharmacist"/>
        
    <menuitem
        id="menu_hospital_pharmacy_stock"
        name="Items"
        parent="menu_hospital_management"
        action="action_hospital_pharmacy_stock_records"
        sequence="30"
        groups="hospital_management.group_hospital_pharmacist"
    />





    <!-- FEES ROOT MENU -->
    <menuitem
        id="menu_hospital_fees_root"
        name="Fees"
        parent="menu_hospital_management"
        sequence="60"
        groups="hospital_management.group_hospital_admin,hospital_management.group_hospital_super_admin"
    />

    <menuitem
        id="menu_hospital_consultation_fees"
        name="Consultation Fees"
        parent="menu_hospital_fees_root"
        action="action_hospital_consultation_fees"
        sequence="10"
        groups="hospital_management.group_hospital_admin,hospital_management.group_hospital_super_admin"
    />

    <menuitem
        id="menu_hospital_consultation_types"
        name="Consultation Types"
        parent="menu_hospital_fees_root"
        action="action_hospital_consultation_types"
        sequence="15"
        groups="hospital_management.group_hospital_admin,hospital_management.group_hospital_super_admin"
    />

    <menuitem
        id="menu_hospital_lab_tests"
        name="Lab Fees"
        parent="menu_hospital_fees_root"
        action="action_hospital_lab_tests"
        sequence="20"
        groups="hospital_management.group_hospital_admin,hospital_management.group_hospital_super_admin,hospital_management.group_hospital_lab_technician"
    />


    <!-- CATEGORIES MASTER -->
    <menuitem
        id="menu_hospital_categories"
        name="Categories"
        parent="menu_hospital_management"
        action="action_hospital_category_master"
        sequence="90"
        groups="hospital_management.group_hospital_super_admin,hospital_management.group_hospital_admin"
    />
    <menuitem
        id="menu_hospital_lab_subtest"
        name="Lab Sub-Tests"
        parent="menu_hospital_management"
        action="action_hospital_lab_subtests"
        sequence="25"
        groups="hospital_management.group_hospital_admin,hospital_management.group_hospital_super_admin,hospital_management.group_hospital_lab_technician"
    />

    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="name">Employees</field>
        <field name="parent_id" ref="menu_hospital_management"/>
        <field name="sequence">100</field>
        <field name="group_ids" eval="[
            (6, 0, [
                ref('group_hospital_admin'),
                ref('group_hospital_super_admin'),
                ref('group_hospital_hr')
            ])
        ]"/>
    </record>

    <!-- ========================================= -->
    <!-- ODOO ASSET MANAGEMENT INSIDE HOSPITAL -->
    <!-- ========================================= -->

    <record id="maintenance.menu_maintenance_title" model="ir.ui.menu">
        <field name="name">Asset Management</field>
        <field name="active" eval="True"/>
        <field name="parent_id" ref="menu_hospital_management"/>
        <field name="sequence">110</field>
        <field name="group_ids" eval="[
            (6, 0, [
                ref('group_hospital_admin'),
                ref('group_hospital_super_admin'),
                
            ])
        ]"/>
    </record>

    


    <!-- HIDE UNWANTED STANDARD APPS -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>


    <!-- Hide Apps and Settings from regular users -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('hospital_management.group_hospital_admin'), ref('hospital_management.group_hospital_super_admin')])]"/>
    </record>

    <record id="base.menu_administration" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('hospital_management.group_hospital_admin'), ref('hospital_management.group_hospital_super_admin')])]"/>
    </record>

</odoo>
