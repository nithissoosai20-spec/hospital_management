    <menuitem
        id="menu_hospital_doctor_patients_queue"
        name="Patients"
        parent="menu_hospital_management"
        action="action_hospital_doctor_patients_queue"
        sequence="31"
        groups="hospital_management.group_hospital_doctor"
    />


    <!-- DOCTORS -->
    <!-- SUPER ADMIN ONLY -->

    <menuitem
        id="menu_hospital_doctors"
        name="Doctors"
        parent="menu_hospital_management"
        action="action_hospital_doctors"
        sequence="35"
        groups="hospital_management.group_hospital_super_admin"
    />


