<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- CREATE PHARMACY VENDOR ACTION -->
    <record id="action_create_pharmacy_vendor" model="ir.actions.act_window">
        <field name="name">Create Vendor</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_is_pharmacy_vendor': True, 'default_supplier_rank': 1}</field>
    </record>

    <!-- PHARMACY STOCK ACTION -->

    <record
        id="action_hospital_pharmacy_stock_records"
        model="ir.actions.act_window"
    >

        <field name="name">Items</field>

        <field name="res_model">hospital.pharmacy.stock</field>

        <field name="view_mode">list,form</field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first item record.
            </p>

            <p>
                Manage items, batches, expiry dates and quantities.
            </p>

        </field>

    </record>

    <!-- STOCK LIST VIEW -->

    <record
        id="view_hospital_pharmacy_stock_list"
        model="ir.ui.view"
    >

        <field name="name">hospital.pharmacy.stock.list</field>

        <field name="model">hospital.pharmacy.stock</field>

        <field name="arch" type="xml">

            <list limit="14"
                string="Items"
                default_order="medicine_name asc"
            >

                <field
                    name="medicine_code"
                    string="Item Code"
                />

                <field
                    name="medicine_name"
                    string="Item Name"
                />

                <field
                    name="item_type"
                    string="Type"
                />

                <field
                    name="primary_category_id"
                    string="Primary Category"
                    optional="show"
                />

                <field
                    name="batch_number"
                    string="Batch"
                />

                <field
                    name="expiry_date"
                    string="Expiry Date"
                />

                <field name="total_stock"/>
                <field name="reorder_level"/>
                <field name="emergency_stock"/>
                <field name="quantity"/>

                <field
                    name="is_reorder_needed"
                    widget="boolean_toggle"
                    readonly="1"
                    optional="show"
                />

                <field
                    name="total_amount"
                    string="Selling Price"
                />

                <field
                    name="stock_status"
                    string="Status"
                    widget="badge"
                    decoration-success="stock_status == 'available'"
                    decoration-warning="stock_status == 'low'"
                    decoration-danger="stock_status in ('critical', 'out', 'expired')"
                />

            </list>

        </field>

    </record>

    <!-- STOCK FORM VIEW -->

    <record
        id="view_hospital_pharmacy_stock_form"
        model="ir.ui.view"
    >

        <field name="name">hospital.pharmacy.stock.form</field>

        <field name="model">hospital.pharmacy.stock</field>

        <field name="arch" type="xml">

            <form string="Item Details" js_class="hospital_pharmacy_stock_form_view">

                <sheet>
                    <!-- =====================================================
                         VENDOR & STATUS
                         ===================================================== -->

                    <div class="oe_title" style="margin-bottom: 20px;">

                        <div name="options" style="display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 20px;">

                            <!-- Vendor Dropdown -->
                            <div style="display: flex; align-items: center; flex-grow: 1;">
                                <label for="vendor_ids" string="Vendor Name" style="font-weight: 600; margin-right: 16px; white-space: nowrap; font-size: 16px;"/>
                                <div style="flex-grow: 1;">
                                    <field
                                        name="vendor_ids"
                                        widget="many2many_tags"
                                        can_create="1"
                                        options="{'no_create': False, 'no_quick_create': False, 'no_create_edit': False}"
                                        placeholder="Select connected vendors..."
                                        domain="[('is_pharmacy_vendor', '=', True)]"
                                        context="{'default_is_pharmacy_vendor': True, 'default_supplier_rank': 1}"
                                        style="width: 100% !important;"
                                    />
                                </div>
                            </div>

                            <!-- Active Toggle -->
                            <div style="display: flex; align-items: center;">
                                <label for="active" string="Active" style="font-weight: 600; margin-right: 10px; font-size: 16px;"/>
                                <field
                                    name="active"
                                    widget="boolean_toggle"
                                />
                            </div>

                        </div>

                    </div>

                    <!-- =====================================================
                         STOCK / BATCH INFORMATION
                         ===================================================== -->

                    <!-- =====================================================
                         3-COLUMN PROFESSIONAL LAYOUT
                         ===================================================== -->
                    <notebook>
                        <page string="General Info">
                            <div class="row" style="margin-top: 40px !important;">
                        
                        <!-- COLUMN 1: Basic & Batch Details -->
                        <div class="col-md-4">
                            <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Item &amp; Batch Details</h5>
                            <group>
                                <field name="item_type"/>
                                <field name="medicine_name" placeholder="e.g. Paracetamol 500mgs / Dell Laptop" string="Item Name"/>
                                <field name="medicine_code" placeholder="e.g. MED001 / IT-001" string="Item Code"/>
                                <field name="batch_number"/>
                                <field name="expiry_date"/>
                                <field name="hsn_code"/>
                            </group>
                        </div>

                        <!-- COLUMN 2: Stock & Inventory -->
                        <div class="col-md-4">
                            <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Stock &amp; Inventory</h5>
                            <group>
                                <field name="primary_category_id" options="{'no_open': True}"/>
                                <field name="pharmacy_category_id" options="{'no_create': True, 'no_open': True}" readonly="item_type == 'non_consumable'"/>
                                <field name="additional_category_id" options="{'no_create': True, 'no_open': True}" readonly="item_type == 'non_consumable'"/>
                                <field name="total_stock"/>
                                <field name="emergency_stock"/>
                                <field name="reorder_level"/>
                                <field name="default_order_qty"/>
                                <field name="quantity" class="fw-bold text-success"/>
                                <field name="stock_status" widget="badge" decoration-success="stock_status == 'available'" decoration-warning="stock_status == 'low'" decoration-danger="stock_status in ('critical', 'out', 'expired')"/>
                                <field name="is_reorder_needed" widget="boolean_toggle" readonly="1"/>
                            </group>
                        </div>

                        <!-- COLUMN 3: Pricing Information -->
                        <div class="col-md-4">
                            <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Pricing Information</h5>
                            <group>
                                <label for="purchase_price" string="Pur. Price"/>
                                <div class="o_row">
                                    <field name="purchase_price"/>
                                    <span class="ms-2 me-1 text-muted">MRP</span>
                                    <field name="mrp"/>
                                </div>
                                
                                <label for="pharmacy_item_category_id" string="Item Category"/>
                                <div class="o_row">
                                    <field name="pharmacy_item_category_id" readonly="item_type == 'non_consumable'" options="{'no_open': True}"/>
                                    <span class="ms-2 me-1 text-muted" style="white-space: nowrap;">Qty in Category</span>
                                    <field name="qty_in_category"/>
                                </div>
                                
                                <label for="amount_per_item" string="Amt/Item"/>
                                <div class="o_row">
                                    <field name="amount_per_item" readonly="1" force_save="1" class="o_input bg-light"/>
                                    <span class="ms-2 me-1 text-muted" style="white-space: nowrap;">Discount %</span>
                                    <field name="discount_percent" readonly="item_type == 'non_consumable'"/>
                                    <span class="ms-2 me-1 text-muted">Amt</span>
                                    <field name="discount_amount" readonly="1" force_save="1" class="o_input bg-light"/>
                                </div>

                                <label for="selling_price" string="Selling Amount"/>
                                <div class="o_row">
                                    <field name="selling_price" readonly="1" force_save="1" class="o_input bg-light"/>
                                </div>

                                <label for="cgst" string="CGST (%)"/>
                                <div class="o_row">
                                    <field name="cgst"/>
                                    <span class="ms-2 me-1 text-muted">Amt</span>
                                    <field name="cgst_amount" readonly="1" force_save="1" class="o_input bg-light"/>
                                </div>
                                
                                <label for="sgst" string="SGST (%)"/>
                                <div class="o_row">
                                    <field name="sgst"/>
                                    <span class="ms-2 me-1 text-muted">Amt</span>
                                    <field name="sgst_amount" readonly="1" force_save="1" class="o_input bg-light"/>
                                </div>
                                
                                <label for="igst" string="IGST (%)"/>
                                <div class="o_row">
                                    <field name="igst"/>
                                    <span class="ms-2 me-1 text-muted">Amt</span>
                                    <field name="igst_amount" readonly="1" force_save="1" class="o_input bg-light"/>
                                </div>

                                <label for="total_amount" string="Total Amount"/>
                                <div>
                                    <field name="total_amount" readonly="1" force_save="1" style="border: 2px solid #2563eb; background-color: #eff6ff; color: #1e3a8a; font-weight: bold; padding: 4px 12px; border-radius: 4px; display: block; width: 100%; text-align: center;"/>
                                </div>

                            </group>
                        </div>

                    </div>
                    </page>
                    <page string="Specifications">
                        <div class="row mt-4">
                            <!-- SECTION 1: PHYSICAL -->
                            <div class="col-md-6 mb-4">
                                <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Physical Specifications</h5>
                                <group>
                                    <field name="spec_material"/>
                                    <field name="spec_colour"/>
                                    <label for="spec_length" string="Length / Width"/>
                                    <div class="o_row">
                                        <field name="spec_length"/> <span class="ms-1 me-2">cm</span>
                                        <field name="spec_width"/> <span class="ms-1">cm</span>
                                    </div>
                                    <label for="spec_height" string="Height / Weight"/>
                                    <div class="o_row">
                                        <field name="spec_height"/> <span class="ms-1 me-2">cm</span>
                                        <field name="spec_weight"/> <span class="ms-1">gm</span>
                                    </div>
                                    <field name="spec_shape"/>
                                    <field name="spec_measurement_range"/>
                                    <field name="spec_accuracy"/>
                                </group>
                            </div>

                            <!-- SECTION 2: USAGE & CALIBRATION -->
                            <div class="col-md-6 mb-4">
                                <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Usage &amp; Calibration</h5>
                                <group>
                                    <field name="spec_display_type"/>
                                    <field name="spec_power_source"/>
                                    <field name="spec_battery_type"/>
                                    <field name="spec_calibration_required"/>
                                    <field name="spec_calibration_frequency" invisible="spec_calibration_required != 'yes'"/>
                                    <field name="spec_sterilization_compatible"/>
                                </group>
                            </div>

                            <!-- SECTION 3: TECHNICAL -->
                            <div class="col-md-6 mb-4">
                                <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Technical Specs</h5>
                                <group>
                                    <field name="spec_operating_voltage"/>
                                    <field name="spec_power_consumption"/>
                                    <field name="spec_response_time"/>
                                    <field name="spec_memory_function"/>
                                </group>
                            </div>

                            <!-- SECTION 4: ORIGIN & COMPLIANCE -->
                            <div class="col-md-6 mb-4">
                                <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Origin &amp; Compliance</h5>
                                <group>
                                    <field name="spec_water_resistance"/>
                                    <field name="spec_compatibility"/>
                                    <field name="spec_country_of_origin"/>
                                    <field name="spec_certification"/>
                                </group>
                            </div>
                        </div>
                    </page>
                    <page string="Attachments &amp; Compliance">
                        <div class="row">
                            <div class="col-md-4">
                                <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Item Image</h5>
                                <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920', 'size': [256, 256]}" style="margin: 0;"/>
                            </div>
                            <div class="col-md-8">
                                <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Documents</h5>
                                <p class="text-muted" style="margin-top: 10px;">
                                    Please use the standard Odoo attachments (paperclip icon at the top) or chatter to upload PDF documents, manuals, and compliance certificates.
                                </p>
                            </div>
                        </div>
                    </page>
                    </notebook>

                    <!-- =====================================================
                         ACTION BUTTONS
                         ===================================================== -->

                    <div
                        class="d-flex justify-content-end mt-4 mb-2 gap-2"
                        style="margin-left: auto !important; justify-content: flex-end; display: flex; gap: 10px;"
                    >

                        <a
                            role="button"
                            class="btn btn-secondary btn-custom-clear"
                            style="color: white; background-color: #6c757d; border-color: #6c757d; cursor: pointer; padding: 0.375rem 0.75rem; border-radius: 0.25rem;"
                        >
                            Clear
                        </a>

                        <a
                            role="button"
                            class="btn btn-danger btn-custom-close"
                            style="color: white; cursor: pointer; padding: 0.375rem 0.75rem; border-radius: 0.25rem;"
                        >
                            Close
                        </a>

                        <button
                            name="action_save"
                            string="Save"
                            type="object"
                            class="oe_highlight"
                        />

                    </div>

                </sheet>

            </form>

        </field>

    </record>

    <!-- EMPTY SPECS WIZARD VIEW -->
    <record id="view_hospital_empty_specs_wizard_form" model="ir.ui.view">
        <field name="name">hospital.empty.specs.wizard.form</field>
        <field name="model">hospital.empty.specs.wizard</field>
        <field name="arch" type="xml">
            <form string="Missing Specifications">
                <div class="alert alert-warning" role="alert" style="margin-bottom: 20px; font-size: 15px;">
                    <strong>Warning:</strong> No specifications have been entered for this item. Do you want to proceed anyway?
                </div>
                <footer class="d-flex justify-content-end gap-2">
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                    <button name="action_proceed" string="Proceed &amp; Save" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>