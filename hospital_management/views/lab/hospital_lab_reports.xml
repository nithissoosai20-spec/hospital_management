<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="action_report_hospital_lab_receipt" model="ir.actions.report">
        <field name="name">Lab Fee Receipt</field>
        <field name="model">hospital.lab.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_hospital_a4"/>
        <field name="report_name">hospital_management.report_hospital_lab_receipt</field>
        <field name="report_file">hospital_management.report_hospital_lab_receipt</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_lab_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_hospital_lab_result" model="ir.actions.report">
        <field name="name">Lab Result Report</field>
        <field name="model">hospital.lab.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_hospital_a4"/>
        <field name="report_name">hospital_management.report_hospital_lab_result</field>
        <field name="report_file">hospital_management.report_hospital_lab_result</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_lab_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hospital_lab_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                
                    <style>
                        .o_report_footer, footer, .o_footer, #wkhtmltopdf-footer, .footer-block { display: none !important; }
                        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                        .lab-info-table td {
                            padding: 2px 0;
                            font-size: 12px;
                            color: #333;
                        }
                    </style>

                    <div class="article" style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                        <div class="page" style="position: relative; width: 210mm; height: 297mm; min-height: 297mm; overflow: hidden; margin: 0; padding: 0; box-sizing: border-box;">
                            
                            <!-- BACKGROUND & BORDERS -->
                            <div style="position: absolute; top: 3mm; right: 6mm; bottom: 3mm; left: 3mm; width: auto; height: auto; z-index: 0; overflow: hidden;">
                                <img src="/hospital_management/static/src/img/purchase_bg.png" style="display: block; width: 100%; height: 100%; max-width: none; object-fit: fill; opacity: 1.0;"/>
                            </div>

                            <!-- CONTENT WRAPPER -->
                            <div style="position: relative; z-index: 1; padding-top: 75mm; padding-left: 15mm; padding-right: 15mm; padding-bottom: 15mm; height: 100%; overflow: hidden; box-sizing: border-box;">
                                
                                <!-- RECEIPT TITLE -->
                                <div style="text-align: center; margin-bottom: 15px; border-bottom: 2px solid #29398f; padding-bottom: 6px;">
                                    <h4 style="margin: 0; font-weight: bold; color: #29398f; letter-spacing: 1.5px; font-size: 16px;">
                                        LABORATORY PAYMENT RECEIPT
                                    </h4>
                                </div>

                                <!-- PATIENT & RECEIPT DETAILS -->
                                <div class="row pt-1" style="font-size: 12px; color: #333; line-height: 22px;">
                                    <div class="col-4">
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Patient Name</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span><span t-out="doc.get_patient_title_name()"/></span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Patient ID</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span><span t-field="doc.patient_id.patient_id"/></span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Age / Gender</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span>
                                                <t t-if="doc.patient_id and doc.patient_id.age"><span t-field="doc.patient_id.age"/> Y / </t>
                                                <t t-if="doc.patient_id and doc.patient_id.gender">
                                                    <span style="text-transform: capitalize;" t-field="doc.patient_id.gender"/>
                                                </t>
                                            </span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Mobile Number</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span><span t-field="doc.patient_id.phone"/></span>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Doctor Name</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span><span t-out="doc.get_doctor_title_name()"/></span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Department</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span><span t-field="doc.doctor_id.department_id.name"/></span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Token Ref</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span>
                                                <t t-if="doc.hospital_appointment_id">
                                                    <span t-field="doc.hospital_appointment_id.token_number"/>
                                                </t>
                                                <t t-else="">-</t>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Receipt No</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span style="font-weight: bold;"><span t-field="doc.name"/></span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Date &amp; Time</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span>
                                                <span t-field="doc.appointment_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                                <span t-out="doc.get_exact_current_time()"/>
                                            </span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Payment Mode</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span style="text-transform: capitalize;">
                                                <t t-if="doc.payment_mode and doc.payment_mode != 'none' and doc.total_cash_received &gt; 0">
                                                    <span t-field="doc.payment_mode"/> + Cash
                                                </t>
                                                <t t-elif="(not doc.payment_mode or doc.payment_mode == 'none') and doc.total_cash_received &gt; 0">
                                                    Cash
                                                </t>
                                                <t t-elif="doc.payment_mode and doc.payment_mode != 'none' and doc.total_cash_received == 0">
                                                    <span t-field="doc.payment_mode"/>
                                                </t>
                                                <t t-else="">Cash</t>
                                            </span>
                                        </div>
                                        <div style="height: 22px; white-space: nowrap;">
                                            <span style="font-weight: bold; display: inline-block; width: 95px;">Status</span>
                                            <span style="font-weight: bold; display: inline-block; width: 12px; text-align: center;">:</span>
                                            <span style="background-color: #22c55e; color: #ffffff; padding: 2px 10px; border-radius: 3px; font-weight: bold; font-size: 11px;">
                                                PAID
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- BILLED LAB TESTS TABLE -->
                                <table class="table table-sm mt-3" style="width: 100%; border-collapse: collapse; font-size: 12px; border: 1px solid #cbd5e1;">
                                    <thead>
                                        <tr style="background-color: #f1f5f9; color: #1e293b; border-bottom: 2px solid #29398f;">
                                            <th style="padding: 6px 10px; width: 8%; text-align: center; border: 1px solid #cbd5e1;">S.No</th>
                                            <th style="padding: 6px 10px; width: 52%; text-align: left; border: 1px solid #cbd5e1;">Investigation / Test Details</th>
                                            <th style="padding: 6px 10px; width: 22%; text-align: left; border: 1px solid #cbd5e1;">Category</th>
                                            <th style="padding: 6px 10px; width: 18%; text-align: right; border: 1px solid #cbd5e1;">Amount (Rs.)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="sno" t-value="1"/>
                                        <t t-foreach="doc.billing_line_ids" t-as="line">
                                            <t t-if="line.display_type == 'line_section'">
                                                <tr style="background-color: #e2e8f0; font-weight: bold; color: #29398f;">
                                                    <td colspan="4" style="padding: 5px 10px; border: 1px solid #cbd5e1; text-transform: uppercase;">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td style="padding: 5px 10px; text-align: center; border: 1px solid #cbd5e1;"><t t-esc="sno"/></td>
                                                    <td style="padding: 5px 10px; border: 1px solid #cbd5e1; font-weight: 500;">
                                                        <span t-esc="line.lab_test_id.name if line.lab_test_id else line.name"/>
                                                    </td>
                                                    <td style="padding: 5px 10px; border: 1px solid #cbd5e1; color: #475569;">
                                                        <span t-esc="line.lab_category_id.name if line.lab_category_id else (line.lab_test_id.category if line.lab_test_id else '')"/>
                                                    </td>
                                                    <td style="padding: 5px 10px; text-align: right; border: 1px solid #cbd5e1; font-weight: bold;">
                                                        <span t-esc="'%.2f' % line.price"/>
                                                    </td>
                                                </tr>
                                                <t t-set="sno" t-value="sno + 1"/>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>

                                <!-- SUMMARY & TOTALS -->
                                <div class="row mt-3 justify-content-end">
                                    <div class="col-5">
                                        <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-left: auto;">
                                            <tr style="border-top: 2px solid #29398f; font-weight: bold; font-size: 13px;">
                                                <td style="padding: 6px 6px;">Total Billed Amount:</td>
                                                <td style="padding: 6px 6px; text-align: right;">Rs. <span t-esc="'%.2f' % doc.amount"/></td>
                                            </tr>
                                            <tr style="font-weight: bold; color: #16a34a;">
                                                <td style="padding: 4px 6px;">Amount Received:</td>
                                                <td style="padding: 4px 6px; text-align: right;">Rs. <span t-esc="'%.2f' % doc.amount"/></td>
                                            </tr>
                                            <tr style="color: #64748b;">
                                                <td style="padding: 4px 6px;">Balance Due:</td>
                                                <td style="padding: 4px 6px; text-align: right;">Rs. 0.00</td>
                                            </tr>
                                            <tr style="border-top: 1px solid #e2e8f0;">
                                                <td style="padding: 6px 6px; font-weight: bold;">Payment Status:</td>
                                                <td style="padding: 6px 6px; text-align: right;">
                                                    <span style="background-color: #22c55e; color: white; padding: 2px 10px; border-radius: 3px; font-weight: bold; font-size: 11px;">
                                                        PAID
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <!-- SIGNATURES & NOTICE -->
                                <div style="margin-top: 40px; display: flex; justify-content: space-between; align-items: flex-end; font-size: 11px; color: #475569; border-top: 1px dashed #cbd5e1; padding-top: 12px;">
                                    <div>
                                        <span>* Thank you for choosing RIALKG Medical Center &amp; Hospital.</span><br/>
                                        <span>* This is a computer generated payment receipt.</span>
                                    </div>
                                    <div style="text-align: right;">
                                        <div style="font-weight: bold; color: #1e293b; margin-top: 20px;">
                                            Cashier / Reception Signature
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                
            </t>
        </t>
    </template>

    <template id="report_hospital_lab_result">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                
                    <style>
                        .o_report_footer, footer, .o_footer, #wkhtmltopdf-footer, .footer-block { display: none !important; }
                        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                    </style>

                    <div class="article" style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                        <div class="page" style="position: relative; width: 210mm; height: 297mm; min-height: 297mm; overflow: hidden; margin: 0; padding: 0; box-sizing: border-box;">
                            
                            <!-- BACKGROUND & BORDERS -->
                            <div style="position: absolute; top: 3mm; right: 6mm; bottom: 3mm; left: 3mm; width: auto; height: auto; z-index: 0; overflow: hidden;">
                                <img src="/hospital_management/static/src/img/purchase_bg.png" style="display: block; width: 100%; height: 100%; max-width: none; object-fit: fill; opacity: 1.0;"/>
                                </div>

                            <!-- CONTENT WRAPPER -->
                            <div style="position: relative; z-index: 1; padding-top: 75mm; padding-left: 15mm; padding-right: 15mm; padding-bottom: 15mm; height: 100%; overflow: hidden; box-sizing: border-box;">
                                <div class="row mb-4">
                                    <div class="col-6">
                                        <strong>Patient Name:</strong> <span t-out="doc.get_patient_title_name()"/><br/>
                                        <strong>Patient ID:</strong> <span t-field="doc.patient_id.patient_id"/><br/>
                                        <strong>Age/Gender:</strong> <span t-field="doc.patient_id.age"/> / <span t-field="doc.patient_id.gender"/><br/>
                                        <strong>Mobile Number:</strong> <span t-field="doc.patient_id.phone"/>
                                    </div>
                                    <div class="col-6 text-end">
                                        <strong>Report Date:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/><br/>
                                        <strong>Collection Date:</strong> <span t-field="doc.appointment_date" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/> <span t-out="doc.get_exact_current_time()"/><br/>
                                        <strong>Doctor Name:</strong> <span t-out="doc.get_doctor_title_name()"/>
                                    </div>
                                </div>

                                <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 20px; border: none !important;">
                                    <thead>
                                        <tr style="background-color: #e2e8f0;">
                                            <th style="padding: 6px 10px; color: #000; border: none; text-align: left; width: 40%;">INVESTIGATION</th>
                                            <th style="padding: 6px 10px; color: #000; border: none; text-align: left; width: 15%;">RESULT</th>
                                            <th style="padding: 6px 10px; color: #000; border: none; text-align: left; width: 15%;">UNITS</th>
                                            <th style="padding: 6px 10px; color: #000; border: none; text-align: left; width: 30%;">REF VALUE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.result_line_ids" t-as="line">
                                            <t t-if="line.display_type == 'line_section'">
                                                <tr>
                                                    <!-- Spacing above section header -->
                                                    <td colspan="4" style="border: none !important; padding-top: 15px;"></td>
                                                </tr>
                                                <tr>
                                                    <td colspan="4" style="border: none !important; font-weight: bold; font-size: 14px; padding: 0px 10px 5px 10px; color: #000; text-align: left; text-transform: uppercase;">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td style="border: 1px solid #d1d5db; padding: 6px 10px; text-align: left; color: #000;"><span t-field="line.subtest_id.name"/></td>
                                                    <td style="border: 1px solid #d1d5db; padding: 6px 10px; text-align: left; color: #000;"><span t-field="line.result_value"/></td>
                                                    <td style="border: 1px solid #d1d5db; padding: 6px 10px; text-align: left; color: #000;"><span t-field="line.unit"/></td>
                                                    <td style="border: 1px solid #d1d5db; padding: 6px 10px; text-align: left; color: #000;"><span t-field="line.normal_range_display"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                                
                                <div style="text-align: center; margin-top: 30px; border-top: 1px solid #000; padding-top: 8px; font-size: 13px; font-weight: bold;">
                                    End of Report
                                </div>
                                <div style="text-align: right; margin-top: 60px; padding-right: 20px; font-size: 13px; font-weight: bold;">
                                    Lab technologist
                                </div>
                            </div>
                        </div>
                    </div>
                
            </t>
        </t>
    </template>
</odoo>
