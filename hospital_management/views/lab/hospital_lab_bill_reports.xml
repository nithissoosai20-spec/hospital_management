<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_lab_bill_dot_matrix" model="report.paperformat">
        <field name="name">Dot Matrix Lab Bill</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">140</field>
        <field name="page_width">215</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">28</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_hospital_lab_bill" model="ir.actions.report">
        <field name="name">Lab Payment Receipt</field>
        <field name="model">hospital.lab.bill</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_lab_bill_dot_matrix"/>
        <field name="report_name">hospital_management.report_hospital_lab_bill</field>
        <field name="report_file">hospital_management.report_hospital_lab_bill</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_lab_bill"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hospital_lab_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="header">
                    <div class="row" style="border-bottom: 2px solid black; padding-bottom: 5px;">
                        <div class="col-6">
                            <img src="/hospital_management/static/src/img/hospital_header_left.png" style="max-height: 25mm; max-width: 100%;"/>
                        </div>
                        <div class="col-6 text-end">
                            <img src="/hospital_management/static/src/img/hospital_header_right.png" style="max-height: 25mm; max-width: 100%;"/>
                        </div>
                    </div>
                </div>

                <div class="article" style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
                    <div class="page" style="width: 100%;">
                        <div class="row mb-3 pt-2">
                            <div class="col-6">
                                <h5 style="color: #000; margin-bottom: 4px;">
                                    <strong>Lab Bill: </strong> <span t-field="doc.name"/>
                                </h5>
                                <t t-if="doc.admission_type == 'with_admission'">
                                    <strong>Patient Name:</strong> <span t-out="doc.get_patient_title_name()"/><br/>
                                    <strong>Patient ID:</strong> <span t-field="doc.patient_id.patient_id"/><br/>
                                    <strong>Admission:</strong> <span style="color:#1e3a8a; font-weight:bold;">With Admission</span>
                                </t>
                                <t t-else="">
                                    <strong>Customer:</strong> <span t-field="doc.walkin_name"/><br/>
                                    <strong>Phone:</strong> <span t-field="doc.walkin_phone"/><br/>
                                    <strong>Admission:</strong> <span style="color:#64748b; font-weight:bold;">Without Admission (Walk-in)</span>
                                </t>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Date &amp; Time:</strong> <span t-out="doc.get_exact_current_time()"/><br/>
                                <strong>Referring Doctor:</strong> <span t-out="doc.get_doctor_title_name()"/><br/>
                                <t t-if="doc.doctor_department_id">
                                    <strong>Department:</strong> <span t-field="doc.doctor_department_id.name"/><br/>
                                </t>
                                <strong>Payment Mode:</strong> <span style="text-transform:uppercase; font-weight:bold; color:#16a34a;" t-field="doc.payment_mode"/>
                            </div>
                        </div>

                        <table class="table table-sm mt-2" style="width: 100%; margin-bottom: 1rem; border-collapse: collapse; font-size: 12px;">
                            <thead>
                                <tr>
                                    <th style="padding: 4px; border-top: 1px solid black !important; border-bottom: 1px solid black !important;">S.No</th>
                                    <th style="padding: 4px; border-top: 1px solid black !important; border-bottom: 1px solid black !important;">Test Code</th>
                                    <th style="padding: 4px; border-top: 1px solid black !important; border-bottom: 1px solid black !important;">Test Description</th>
                                    <th style="padding: 4px; border-top: 1px solid black !important; border-bottom: 1px solid black !important;">Category</th>
                                    <th class="text-end" style="padding: 4px; border-top: 1px solid black !important; border-bottom: 1px solid black !important;">Rate (₹)</th>
                                    <th class="text-end" style="padding: 4px; border-top: 1px solid black !important; border-bottom: 1px solid black !important;">Disc (%)</th>
                                    <th class="text-end" style="padding: 4px; border-top: 1px solid black !important; border-bottom: 1px solid black !important;">Total (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="sno" t-value="1"/>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td style="padding: 4px; border: none; border-bottom: 1px solid #ddd !important;"><t t-esc="sno"/></td>
                                        <td style="padding: 4px; border: none; border-bottom: 1px solid #ddd !important;"><span t-field="line.test_code"/></td>
                                        <td style="padding: 4px; border: none; border-bottom: 1px solid #ddd !important; font-weight:bold;"><span t-field="line.test_name"/></td>
                                        <td style="padding: 4px; border: none; border-bottom: 1px solid #ddd !important;"><span t-field="line.category_name"/></td>
                                        <td class="text-end" style="padding: 4px; border: none; border-bottom: 1px solid #ddd !important;"><span t-field="line.price"/></td>
                                        <td class="text-end" style="padding: 4px; border: none; border-bottom: 1px solid #ddd !important;"><span t-field="line.discount"/></td>
                                        <td class="text-end" style="padding: 4px; border: none; border-bottom: 1px solid #ddd !important; font-weight:bold;"><span t-field="line.total_amount"/></td>
                                    </tr>
                                    <t t-set="sno" t-value="sno + 1"/>
                                </t>
                            </tbody>
                        </table>

                        <div class="row" style="margin-top: 10px;">
                            <div class="col-7">
                                <p style="font-size: 11px; color: #555; margin-top: 10px;">
                                    * This is a computer generated payment receipt.<br/>
                                    * Please present this receipt at the laboratory counter for sample collection.<br/>
                                    <strong>Status:</strong> <span style="text-transform:uppercase; color:#16a34a; font-weight:bold;" t-field="doc.state"/>
                                </p>
                            </div>
                            <div class="col-5">
                                <table class="table table-sm" style="width: 100%; font-size: 12px; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 3px; border: none;">Subtotal:</td>
                                        <td class="text-end" style="padding: 3px; border: none;">₹ <span t-field="doc.subtotal"/></td>
                                    </tr>
                                    <t t-if="doc.discount_amount">
                                        <tr>
                                            <td style="padding: 3px; border: none;">Discount:</td>
                                            <td class="text-end" style="padding: 3px; border: none; color:red;">- ₹ <span t-field="doc.discount_amount"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="doc.round_off">
                                        <tr>
                                            <td style="padding: 3px; border: none;">Round Off:</td>
                                            <td class="text-end" style="padding: 3px; border: none;">₹ <span t-field="doc.round_off"/></td>
                                        </tr>
                                    </t>
                                    <tr style="border-top: 1px solid black; border-bottom: 1px solid black;">
                                        <td style="padding: 4px; font-weight: bold; font-size: 13px;">Net Paid:</td>
                                        <td class="text-end" style="padding: 4px; font-weight: bold; font-size: 13px; color:#1e3a8a;">₹ <span t-field="doc.total_amount"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-4 pt-3">
                            <div class="col-6">
                                <br/><br/>
                                <span>Patient / Attendant Signature</span>
                            </div>
                            <div class="col-6 text-end">
                                <br/><br/>
                                <span>Authorized Lab Signatory</span>
                            </div>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
