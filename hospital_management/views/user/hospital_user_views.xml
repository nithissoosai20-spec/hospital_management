<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- USERS LIST                                         -->

    <record id="view_hospital_user_list" model="ir.ui.view">

        <field name="name">hospital.user.list</field>
        <field name="model">hospital.user</field>

        <field name="arch" type="xml">

            <list>

                <field name="employee_id"/>
                <field name="name"/>
                <field name="login"/>
                <field name="role_id"/>
                <field name="department_id"/>
                <field name="designation_id"/>
                <field name="email"/>
                <field name="active"/>
                <button name="action_view_history" type="object" string="History" class="btn btn-sm btn-secondary rounded-pill px-3" title="View History"/>
            </list>

        </field>

    </record>


    <!-- USER FORM                                          -->

    <record id="view_hospital_user_form" model="ir.ui.view">

        <field name="name">hospital.user.form</field>
        <field name="model">hospital.user</field>

        <field name="arch" type="xml">

            <form js_class="hospital_user_form_view" class="hospital_user_form">

                <!-- SAVE BUTTON IN HEADER                 -->

                

                <sheet>
                    <style>
                        .pwd-helper {
                            display: none;
                            color: #ef4444;
                            font-size: 11px;
                            margin-top: 4px;
                        }
                        .custom-field-container:focus-within .pwd-helper {
                            display: block;
                        }
                    </style>
                    <style>
                        .custom-section-title {
                            color: #1e3a8a;
                            font-size: 16px;
                            font-weight: bold;
                            margin-top: 15px;
                            margin-bottom: 10px;
                            border-bottom: 1px solid #e2e8f0;
                            padding-bottom: 5px;
                        }
                        .custom-label {
                            font-weight: 600;
                            font-size: 12px;
                            color: #475569;
                            margin-bottom: 4px;
                            display: block;
                        }
                        .custom-field-container {
                            margin-bottom: 12px;
                        }

                        /* Consultation Types and Fees Table - No horizontal scroll and wide columns */
                        .doctor_consultation_table,
                        .doctor_consultation_table .table-responsive,
                        .doctor_consultation_table .o_list_renderer {
                            overflow-x: hidden !important;
                            overflow-y: visible !important;
                            width: 100% !important;
                            max-width: 100% !important;
                        }

                        .doctor_consultation_table table.o_list_table {
                            table-layout: fixed !important;
                            width: 100% !important;
                        }

                        .doctor_consultation_table table.o_list_table th,
                        .doctor_consultation_table table.o_list_table th span,
                        .doctor_consultation_table table.o_list_table th div,
                        .doctor_consultation_table table.o_list_table th .text-truncate {
                            white-space: nowrap !important;
                            text-overflow: unset !important;
                            overflow: visible !important;
                        }

                        .doctor_consultation_table th[data-name="consultation_type_id"],
                        .doctor_consultation_table td[name="consultation_type_id"] {
                            width: 65% !important;
                        }

                        .doctor_consultation_table th[data-name="fee"],
                        .doctor_consultation_table td[name="fee"] {
                            width: 30% !important;
                            text-align: right !important;
                        }

                        .doctor_consultation_table th.o_list_record_remove_header,
                        .doctor_consultation_table td.o_list_record_remove {
                            width: 5% !important;
                            text-align: center !important;
                        }
                    </style>

                    <field name="is_doctor" invisible="1"/>
                    <field name="existing_consultation_type_ids" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_hr_employee" type="object" class="oe_stat_button" icon="fa-id-card" string="HR Profile" invisible="not hr_employee_id"/>
                        <button name="action_view_history" type="object" class="oe_stat_button" icon="fa-history" string="Login History"/>
                    </div>
                    <notebook>
                        <page string="General Info" name="general_info">
                            <div class="custom-section-title">1. Personal Information</div>
                            <div class="row">
                                <div class="col-md-4 custom-field-container">
                                    <label for="name" class="custom-label">Full Name *</label>
                                    <field name="name" class="w-100" placeholder="Enter full name"/>
                                </div>
                                <div class="col-md-4 custom-field-container">
                                    <label for="employee_id" class="custom-label">Employee ID</label>
                                    <field name="employee_id" class="w-100" placeholder="e.g. EMP-001"/>
                                </div>
                                <div class="col-md-4 custom-field-container">
                                    <label for="login" class="custom-label">Username *</label>
                                    <field name="login" class="w-100" placeholder="Enter username"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 custom-field-container">
                                    <label for="email" class="custom-label">Email Address</label>
                                    <field name="email" class="w-100" placeholder="example@hospital.com"/>
                                </div>
                                <div class="col-md-4 custom-field-container">
                                    <label for="mobile" class="custom-label">Mobile Number</label>
                                    <field name="mobile" class="w-100" placeholder="Enter mobile number"/>
                                </div>
                                <div class="col-md-4 custom-field-container">
                                    <label for="date_of_birth" class="custom-label">Date of Birth</label>
                                    <field name="date_of_birth" class="w-100"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 custom-field-container">
                                    <label for="gender" class="custom-label">Gender</label>
                                    <field name="gender" class="w-100" required="1"/>
                                </div>
                                <div class="col-md-8 custom-field-container">
                                    <label for="address" class="custom-label">Address</label>
                                    <field name="address" class="w-100" placeholder="Enter full address"/>
                                </div>
                            </div>

                            <div class="custom-section-title">2. Work Information</div>
                            <field name="allowed_department_ids" invisible="1"/>
                            <div class="row">
                                <div class="col-md-4 custom-field-container">
                                    <label for="role_id" class="custom-label">Role</label>
                                    <field name="role_id" class="w-100" options="{'no_create': True}" required="1"/>
                                </div>
                                <div class="col-md-4 custom-field-container">
                                    <label for="department_id" class="custom-label">Department</label>
                                    <field name="department_id" class="w-100" domain="[('id', 'in', allowed_department_ids)]" options="{'no_create': True}"/>
                                </div>
                                <div class="col-md-4 custom-field-container">
                                    <label for="designation_id" class="custom-label">Designation</label>
                                    <field name="designation_id" class="w-100" domain="[('department_id', '=', department_id)]" options="{'no_create': True}"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 custom-field-container">
                                    <label for="reporting_to_id" class="custom-label">Reporting To</label>
                                    <field name="reporting_to_id" class="w-100" domain="[('id', '!=', id), ('role_id', '=', role_id), ('department_id', '=', department_id)]" options="{'no_create': True}"/>
                                </div>
                                <div class="col-md-4 custom-field-container">
                                    <label for="hr_employee_id" class="custom-label">Linked HR Employee</label>
                                    <field name="hr_employee_id" class="w-100" readonly="1"/>
                                </div>
                            </div>

                            <div class="custom-section-title">3. Access &amp; Security</div>
                            <div class="row">
                                <div class="col-md-2 custom-field-container">
                                    <label for="active" class="custom-label">Active</label>
                                    <field name="active" widget="boolean_toggle"/>
                                </div>
                                <div class="col-md-5 custom-field-container">
                                    <label for="password" class="custom-label">Password</label>
                                    <field name="password" class="w-100" password="True" required="not id"/>
                                    <small class="pwd-helper">
                                        Must be at least 8 characters containing a capital letter, small letter, number, and special symbol.
                                    </small>
                                </div>
                                <div class="col-md-5 custom-field-container">
                                    <label for="password_confirm" class="custom-label">Re-enter Password</label>
                                    <field name="password_confirm" class="w-100" password="True" required="not id"/>
                                </div>
                            </div>
                        </page>

                        <page string="Access &amp; Permissions" name="access_permissions">
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                <div>
                                    <div class="custom-section-title mt-0 mb-1">
                                        <i class="fa fa-shield text-primary me-2" title="Permissions"></i> Role &amp; Access Control (Approach 3)
                                    </div>
                                    <small class="text-muted">Permissions are automatically populated from the user's role and can be customized per user by the Administrator.</small>
                                </div>
                                <div>
                                    <button name="action_reset_permissions" type="object" string="Reset to Role Defaults" class="btn btn-sm btn-outline-secondary rounded-pill px-3" icon="fa-undo"/>
                                </div>
                            </div>

                            <div class="row">
                                <!-- COLUMN 1: PAGE & MODULE VISIBILITY -->
                                <div class="col-md-7 pe-md-4 border-end">
                                    <div class="custom-section-title mt-0">
                                        <i class="fa fa-desktop me-1" title="Modules"></i> Module &amp; Menu Visibility
                                    </div>
                                    <p class="text-muted small mb-3">Controls which apps and menus this user is permitted to view and access.</p>

                                    <div class="row g-2">
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_dashboard" class="custom-label">Main Dashboard</label>
                                            <field name="perm_dashboard" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_appointments" class="custom-label">Appointments &amp; Booking</label>
                                            <field name="perm_appointments" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_patients" class="custom-label">Patients Directory &amp; Queue</label>
                                            <field name="perm_patients" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_billing" class="custom-label">Billing &amp; Invoices</label>
                                            <field name="perm_billing" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_pharmacy" class="custom-label">Pharmacy &amp; Stock</label>
                                            <field name="perm_pharmacy" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_lab" class="custom-label">Laboratory &amp; Tests</label>
                                            <field name="perm_lab" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_hr_employees" class="custom-label">Employees Directory</label>
                                            <field name="perm_hr_employees" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_attendance" class="custom-label">Staff Attendances</label>
                                            <field name="perm_attendance" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_time_off" class="custom-label">Time Off / Leaves</label>
                                            <field name="perm_time_off" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_expenses" class="custom-label">Expense Claims</label>
                                            <field name="perm_expenses" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_asset_items" class="custom-label">Assets &amp; Equipment</label>
                                            <field name="perm_asset_items" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_asset_requests" class="custom-label">Asset Requests &amp; Purchases</label>
                                            <field name="perm_asset_requests" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_masters" class="custom-label">Master Data &amp; Fees</label>
                                            <field name="perm_masters" widget="boolean_toggle"/>
                                        </div>
                                        <div class="col-md-6 custom-field-container">
                                            <label for="perm_users" class="custom-label">User Management</label>
                                            <field name="perm_users" widget="boolean_toggle"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- COLUMN 2: ACTION & AUTHORITY RIGHTS -->
                                <div class="col-md-5 ps-md-4">
                                    <div class="custom-section-title mt-0">
                                        <i class="fa fa-lock me-1" title="Actions"></i> Action &amp; Operational Rights
                                    </div>
                                    <p class="text-muted small mb-3">Controls functional actions this user is authorized to perform.</p>

                                    <div class="d-flex flex-column gap-3 mt-2">
                                        <div class="p-2 border rounded bg-light">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong class="text-dark">Can Delete Records</strong>
                                                    <small class="text-muted d-block">Authorize user to delete records</small>
                                                </div>
                                                <field name="perm_can_delete" widget="boolean_toggle"/>
                                            </div>
                                        </div>

                                        <div class="p-2 border rounded bg-light">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong class="text-dark">Can Approve Requests</strong>
                                                    <small class="text-muted d-block">Approve leaves, expenses, and asset requests</small>
                                                </div>
                                                <field name="perm_can_approve" widget="boolean_toggle"/>
                                            </div>
                                        </div>

                                        <div class="p-2 border rounded bg-light">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong class="text-dark">Can Collect Cash / Settle</strong>
                                                    <small class="text-muted d-block">Confirm payments &amp; cash collections</small>
                                                </div>
                                                <field name="perm_can_collect_cash" widget="boolean_toggle"/>
                                            </div>
                                        </div>

                                        <div class="p-2 border rounded bg-light">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong class="text-dark">Can Export Data</strong>
                                                    <small class="text-muted d-block">Allow exporting lists &amp; tables to Excel / CSV</small>
                                                </div>
                                                <field name="perm_can_export" widget="boolean_toggle"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="Consultation Types &amp; Fees" name="consultation_types" invisible="not is_doctor">
                            <div class="custom-section-title">
                                Consultation Types &amp; Fees <span style="color: #ef4444;">*</span>
                            </div>
                            <div class="mb-4">
                                <p class="text-muted" style="font-size: 13px; margin-bottom: 8px;">
                                    Configure the consultation types offered by this doctor and their consultation fees. At least one consultation type is required for saving.
                                </p>
                                <field name="consultation_line_ids" class="doctor_consultation_table">
                                    <list editable="bottom">
                                        <field name="consultation_type_id" context="{'doctor_user_id': parent.id}" domain="[('id', 'not in', parent.existing_consultation_type_ids)]" placeholder="Select Consultation Type..." options="{'no_create': True, 'no_open': True}"/>
                                        <field name="fee" string="Doctor Fee (Rs.)" required="1"/>
                                    </list>
                                </field>
                            </div>
                        </page>
                    </notebook>

                    <div class="d-flex justify-content-between align-items-center mt-4 mb-2" style="width: 100%;">
                        <div>
                            <button name="action_close_user_form" type="object" string="Close" class="btn btn-secondary"/>
                        </div>
                        <div>
                            <button
                                name="action_save_user"
                                string="Save"
                                type="object"
                                class="btn-primary"
                            />
                        </div>
                    </div>
                </sheet>

            </form>

        </field>

    </record>


    <!-- ALL USERS                                          -->

    <record id="action_hospital_users" model="ir.actions.act_window">

        <field name="name">Users</field>
        <field name="res_model">hospital.user</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>

    </record>


    <!-- DOCTORS                                            -->

    <record id="action_hospital_doctors" model="ir.actions.act_window">

        <field name="name">Doctors</field>
        <field name="res_model">hospital.user</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('role_id.name', '=', 'Doctor')]</field>

    </record>



    <record id="view_hospital_user_history_form" model="ir.ui.view">
        <field name="name">hospital.user.history.form</field>
        <field name="model">hospital.user</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                                <div class="text-center mb-4 pb-3" style="border-bottom: 1px solid #e2e8f0;">
                    <div style="color: #64748b; font-size: 15px; display: flex; justify-content: center; align-items: center; gap: 8px;">
                        <i class="fa fa-user-circle-o" title="User" style="font-size: 18px;"></i>
                        <field name="name" nolabel="1" readonly="1" style="font-weight: 700; color: #0f172a; margin: 0;"/>
                        <span style="color: #cbd5e1;">|</span>
                        <i class="fa fa-id-badge"></i>
                        <field name="employee_id" nolabel="1" readonly="1" style="margin: 0;"/>
                    </div>
                </div>
                <style>
                    .history-table td {
                        word-spacing: 25px !important;
                    }
                </style>
                <field name="login_history_ids" readonly="1">
                    <list no_open="1" create="0" delete="0" edit="0" decoration-success="logout_time == False" decoration-muted="logout_time != False" class="history-table">
                        <field name="login_time" string="Logged In At"/>
                        <field name="logout_time" string="Logged Out At"/>
                    </list>
                </field>
                <footer>
                    <button name="action_close_user_form" type="object" string="Close" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>