<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Purchase Order Sequence -->
        <record id="seq_hospital_pharmacy_purchase" model="ir.sequence">
            <field name="name">Pharmacy Purchase Order</field>
            <field name="code">hospital.pharmacy.purchase</field>
            <field name="prefix">PO-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Purchase Invoice Sequence -->
        <record id="seq_hospital_pharmacy_purchase_invoice" model="ir.sequence">
            <field name="name">Pharmacy Purchase Invoice</field>
            <field name="code">hospital.pharmacy.purchase.invoice</field>
            <field name="prefix">PINV-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
