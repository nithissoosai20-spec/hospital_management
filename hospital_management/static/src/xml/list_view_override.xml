<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hospital_management.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="replace">
            <button type="button" class="btn btn-primary o_list_button_add" data-hotkey="c" t-on-click="onClickCreate" data-bounce-button="">
                <t t-if="model.root.resModel == 'hospital.category.master'">
                    New Category
                </t>
                <t t-else="">
                    New
                </t>
            </button>
        </xpath>
    </t>
</templates>
