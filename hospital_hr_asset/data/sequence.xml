<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hospital_asset_purchase" model="ir.sequence">
            <field name="name">Asset Purchase Sequence</field>
            <field name="code">hospital.asset.purchase.seq</field>
            <field name="prefix">AST/PO/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_hospital_asset_scrap" model="ir.sequence">
            <field name="name">Asset Scrap Sequence</field>
            <field name="code">hospital.asset.scrap.seq</field>
            <field name="prefix">SCRAP/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_hospital_asset_invoice" model="ir.sequence">
            <field name="name">Asset Invoice Sequence</field>
            <field name="code">hospital.asset.invoice.seq</field>
            <field name="prefix">BILL/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
