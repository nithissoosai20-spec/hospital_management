<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Simplified Asset Request Form for Hospital Staff -->
    <record id="hospital_staff_asset_request_view_form" model="ir.ui.view">
        <field name="name">hospital.staff.asset.request.form</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <form string="My Asset Request">
                
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <label for="name" string="Issue Summary"/>
                        <h1><field name="name" placeholder="e.g. Screen not working"/></h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="equipment_id" string="Which Asset is Broken?" required="1" domain="[('owner_user_id', '=', uid)]"/>
                            <field name="owner_user_id" string="Reported By" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook style="margin-left: 20px; margin-right: 20px;">
                        <page string="Detailed Description">
                            <field name="description" placeholder="Please provide more details about the problem..."/>
                        </page>
                    </notebook>
                
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2" style="margin-right: 20px;">
                        <button string="Submit Request" name="action_submit_request" type="object" class="btn-primary"/>
                        <button string="Cancel Request" name="action_cancel_request" type="object"  class="btn-secondary"/>
                    </div>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Action for Staff My Asset Requests (Force to use the simplified view) -->
    <record id="action_hospital_my_asset_requests" model="ir.actions.act_window">
        <field name="name">My Asset Requests</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('owner_user_id', '=', uid)]</field>
        <field name="context">{'default_owner_user_id': uid}</field>
        <field name="view_ids" eval="[(5, 0, 0), 
            (0, 0, {'view_mode': 'list'}), 
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_hr_asset.hospital_staff_asset_request_view_form')})]"/>
    </record>

</odoo>
