<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_asset_purchase_form" model="ir.ui.view">
        <field name="name">hospital.asset.purchase.form</field>
        <field name="model">hospital.asset.purchase</field>
        <field name="arch" type="xml">
            <form string="Asset Purchase">
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="vendor_id" domain="[('is_company', '=', True)]"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                            <field name="state" invisible="1"/>
                            <field name="invoice_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook style="margin-left: 20px;">
                        <page string="Assets">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="category_id"/>
                                    <field name="name"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total Subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2">
                        <button name="action_confirm_po" string="Confirm PO" type="object" class="btn-primary" invisible="state != 'intent'"/>
                        <button name="action_receive" string="Receive Assets" type="object" class="btn-primary" invisible="state != 'po'"/>
                        <button name="action_create_bill" string="Create Bill" type="object" class="btn-primary" invisible="state != 'received' or invoice_id != False"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_asset_purchase_tree" model="ir.ui.view">
        <field name="name">hospital.asset.purchase.tree</field>
        <field name="model">hospital.asset.purchase</field>
        <field name="arch" type="xml">
            <list string="Asset Purchase">
                <field name="name"/>
                <field name="vendor_id" domain="[('is_company', '=', True)]"/>
                <field name="date_order"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_asset_purchase_intent" model="ir.actions.act_window">
        <field name="name">Asset Purchase Intents</field>
        <field name="res_model">hospital.asset.purchase</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'intent')]</field>
        <field name="context">{'default_state': 'intent'}</field>
    </record>

    <record id="action_asset_purchase_order" model="ir.actions.act_window">
        <field name="name">Asset Purchase Orders</field>
        <field name="res_model">hospital.asset.purchase</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['po', 'received', 'cancel'])]</field>
        <field name="context">{'default_state': 'po'}</field>
    </record>

    <menuitem id="menu_asset_purchase_intent" name="Asset Purchase Intents" parent="hospital_management.menu_hospital_management" action="action_asset_purchase_intent" sequence="117"/>
    <menuitem id="menu_asset_purchase_order" name="Asset Purchase Orders" parent="hospital_management.menu_hospital_management" action="action_asset_purchase_order" sequence="118"/>

</odoo>
