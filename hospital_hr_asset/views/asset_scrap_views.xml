<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_asset_scrap_form" model="ir.ui.view">
        <field name="name">hospital.asset.scrap.form</field>
        <field name="model">hospital.asset.scrap</field>
        <field name="arch" type="xml">
            <form string="Asset Scrap">
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="equipment_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <group style="margin-left: 20px;">
                        <field name="reason"/>
                    </group>
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2">
                        <button name="action_validate" string="Validate" type="object" class="btn-primary" invisible="state == 'done'"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_asset_scrap_tree" model="ir.ui.view">
        <field name="name">hospital.asset.scrap.tree</field>
        <field name="model">hospital.asset.scrap</field>
        <field name="arch" type="xml">
            <list string="Asset Scrap">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_asset_scrap" model="ir.actions.act_window">
        <field name="name">Scrap Orders</field>
        <field name="res_model">hospital.asset.scrap</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['draft', 'done'])]</field>
    </record>

    
</odoo>
