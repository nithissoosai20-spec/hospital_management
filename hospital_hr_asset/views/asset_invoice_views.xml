<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_asset_invoice_form" model="ir.ui.view">
        <field name="name">hospital.asset.invoice.form</field>
        <field name="model">hospital.asset.invoice</field>
        <field name="arch" type="xml">
            <form string="Asset Invoice">
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="purchase_id"/>
                            <field name="vendor_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="payment_date"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2">
                        <button name="action_pay" string="Pay" type="object" class="btn-primary" invisible="state == 'paid'"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_asset_invoice_tree" model="ir.ui.view">
        <field name="name">hospital.asset.invoice.tree</field>
        <field name="model">hospital.asset.invoice</field>
        <field name="arch" type="xml">
            <list string="Asset Invoice">
                <field name="name"/>
                <field name="purchase_id"/>
                <field name="vendor_id"/>
                <field name="amount"/>
                <field name="payment_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_asset_invoice" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">hospital.asset.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hospital_asset_invoice" name="Vendor Bills" parent="hospital_management.menu_hospital_management" action="action_hospital_asset_invoice" sequence="120"/>
</odoo>
