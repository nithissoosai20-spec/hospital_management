<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_asset_invoice_form" model="ir.ui.view">
        <field name="name">hospital.asset.invoice.form</field>
        <field name="model">hospital.asset.invoice</field>
        <field name="arch" type="xml">
            <form string="Asset Invoice">
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="purchase_id"/>
                            <field name="vendor_id"/>
                            <field name="payment_date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="paid_amount"/>
                            <field name="balance_amount"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <group style="margin-left: 20px;">
                        <field name="notes" placeholder="Adjustment notes..."/>
                    </group>
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2">
                        <button name="action_register_payment" string="Register Payment" type="object" class="btn-primary" invisible="state == 'paid'"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_asset_invoice_tree" model="ir.ui.view">
        <field name="name">hospital.asset.invoice.tree</field>
        <field name="model">hospital.asset.invoice</field>
        <field name="arch" type="xml">
            <list string="Asset Invoice">
                <field name="name"/>
                <field name="purchase_id"/>
                <field name="vendor_id"/>
                <field name="amount"/>
                <field name="paid_amount"/>
                <field name="balance_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-warning="state == 'partial'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_asset_invoice" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">hospital.asset.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hospital_asset_payment_wizard_form" model="ir.ui.view">
        <field name="name">hospital.asset.payment.wizard.form</field>
        <field name="model">hospital.asset.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <group>
                    <field name="amount_to_pay"/>
                </group>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button name="action_clear" string="Clear" type="object" class="btn-warning"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
