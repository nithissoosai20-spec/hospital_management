<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard -->
    <record id="action_asset_dashboard" model="ir.actions.act_window">
        <field name="name">Asset Dashboard</field>
        <field name="res_model">hospital.pharmacy.stock</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Items -->
    <record id="action_asset_item" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">hospital.asset.item</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_asset_item_list" model="ir.ui.view">
        <field name="name">hospital.asset.item.list</field>
        <field name="model">hospital.asset.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="item_name"/>
                <field name="item_code"/>
                <field name="asset_category_id"/>
                <field name="quantity"/>
                <field name="uom"/>
                <field name="purchase_price"/>
                <field name="mrp"/>
                <field name="stock_status" widget="badge" decoration-success="stock_status == 'available'" decoration-warning="stock_status == 'low'" decoration-danger="stock_status == 'out' or stock_status == 'critical'"/>
            </list>
        </field>
    </record>
    <record id="view_asset_item_form" model="ir.ui.view">
        <field name="name">hospital.asset.item.form</field>
        <field name="model">hospital.asset.item</field>
        <field name="arch" type="xml">
            <form string="Asset Item" js_class="hospital_asset_item_form_view">
                <sheet>
                    <!-- VENDOR & STATUS -->
                    <div class="oe_title" style="margin-bottom: 20px;">
                        

                        <div name="options" style="display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 20px;">
                            <!-- Vendor Dropdown -->
                            <div style="display: flex; align-items: center; flex-grow: 1;">
                                <label for="vendor_ids" string="Vendor Name" style="font-weight: 600; margin-right: 16px; white-space: nowrap; font-size: 16px;"/>
                                <div style="flex-grow: 1;">
                                    <field
                                        name="vendor_ids"
                                        widget="many2many_tags"
                                        domain="[('supplier_rank', '>', 0)]"
                                        can_create="True"
                                        options="{'no_quick_create': False, 'no_create_edit': False, 'create': []}"
                                        placeholder="Select connected vendors..."
                                        context="{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1}"
                                        style="width: 100% !important;"
                                    />
                                </div>
                            </div>

                            <!-- Active Toggle -->
                            <div style="display: flex; align-items: center;">
                                <label for="active" string="Active" style="font-weight: 600; margin-right: 10px; font-size: 16px;"/>
                                <field name="active" widget="boolean_toggle"/>
                            </div>
                        </div>
                    </div>

                    <!-- 3-COLUMN PROFESSIONAL LAYOUT -->
                    <div class="row" style="margin-top: 40px !important;">
                        
                        <!-- COLUMN 1: Basic & Batch Details -->
                        <div class="col-md-4">
                            <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Item &amp; Batch Details</h5>
                            <group>
                                <field name="item_name" placeholder="e.g. Printer"/>
                                <field name="item_code" placeholder="e.g. AST001"/>
                                <field name="asset_category_id" string="Category" context="{'default_category_type': 'asset_category'}" options="{'no_create': False, 'no_create_edit': False}"/>
                                <field name="batch_number"/>
                                <field name="expiry_date"/>
                                <field name="hsn_code"/>
                            </group>
                        </div>

                        <!-- COLUMN 2: Stock & Inventory -->
                        <div class="col-md-4">
                            <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Stock &amp; Inventory</h5>
                            <group>
                                <field name="total_stock"/>
                                <field name="emergency_stock"/>
                                <field name="reorder_level"/>
                                <field name="quantity" class="fw-bold text-success"/>
                                <field name="stock_status" widget="badge" decoration-success="stock_status == 'available'" decoration-warning="stock_status == 'low'" decoration-danger="stock_status in ('critical', 'out')"/>
                                <field name="is_reorder_needed" widget="boolean_toggle" readonly="1"/>
                            </group>
                        </div>

                        <!-- COLUMN 3: Pricing Information -->
                        <div class="col-md-4">
                            <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Pricing Information</h5>
                            <group>
                                <label for="purchase_price" string="Pur. Price"/>
                                <div class="o_row">
                                    <field name="purchase_price"/>
                                    <span class="ms-2 me-1 text-muted">MRP</span>
                                    <field name="mrp"/>
                                </div>
                                
                                <label for="uom" string="Item Unit"/>
                                <div class="o_row">
                                    <field name="uom"/>
                                </div>
                                
                                <label for="supplier" string="Supplier (Text)"/>
                                <div class="o_row">
                                    <field name="supplier"/>
                                </div>
                            </group>
                        </div>

                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="d-flex justify-content-between align-items-center mt-4 mb-2" style="width: 100%;">
                        <div style="display: flex; gap: 10px;">
                            <a role="button" class="btn btn-danger btn-custom-close" style="color: white; cursor: pointer; padding: 0.375rem 0.75rem; border-radius: 0.25rem;">Close</a>
                            <a role="button" class="btn btn-secondary btn-custom-clear" style="color: white; background-color: #6c757d; border-color: #6c757d; cursor: pointer; padding: 0.375rem 0.75rem; border-radius: 0.25rem;">Clear</a>
                        </div>
                        <div>
                            <button name="action_save" string="Save" type="object" class="oe_highlight" />
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Specification -->
    <record id="action_asset_specification" model="ir.actions.act_window">
        <field name="name">Item Specification</field>
        <field name="res_model">hospital.asset.specification</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_asset_specification_list" model="ir.ui.view">
        <field name="name">hospital.asset.specification.list</field>
        <field name="model">hospital.asset.specification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                
                <field name="item_id"/>
                            <field name="manufacturer"/>
                <field name="model_number"/>
                <field name="warranty_period"/>
            </list>
        </field>
    </record>
    <record id="view_asset_specification_form" model="ir.ui.view">
        <field name="name">hospital.asset.specification.form</field>
        <field name="model">hospital.asset.specification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1>
                            <field name="name" placeholder="Specification Name"/>
                        </h1>
                    </div>
                    
                    <div class="row mt-4" style="margin-left: 10px; margin-right: 10px;">
                        <!-- Column 1: Hardware -->
                        <div class="col-md-4">
                            <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Hardware Details</h5>
                            <group>
                                <field name="item_id"/>
                                <field name="processor"/>
                                <field name="ram"/>
                                <field name="storage"/>
                                <field name="display_size"/>
                            </group>
                        </div>
                        
                        <!-- Column 2: Software & Network -->
                        <div class="col-md-4">
                            <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Software &amp; Device</h5>
                            <group>
                                <field name="operating_system"/>
                                <field name="ip_address"/>
                                <field name="mac_address"/>
                                <field name="serial_number"/>
                                <field name="color"/>
                            </group>
                        </div>
                        
                        <!-- Column 3: Warranty & Support -->
                        <div class="col-md-4">
                            <h5 class="fw-bold mb-3" style="color: #29398f; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px;">Warranty &amp; Support</h5>
                            <group>
                                <field name="manufacturer"/>
                                <field name="model_number"/>
                                <field name="warranty_period"/>
                                <field name="warranty_expiry_date"/>
                                <field name="support_contact"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </div>
                    </div>
                    
                    <group style="margin-left: 20px;" class="mt-4">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Item Requests -->
    <record id="view_asset_purchase_request_search" model="ir.ui.view">
        <field name="name">hospital.asset.purchase.request.search</field>
        <field name="model">hospital.asset.purchase.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="item_id"/>
                <field name="requested_by_id"/>
                <field name="department"/>
                <separator/>
                <filter string="Pharmacy" name="filter_pharmacy" domain="['|', ('department', 'ilike', 'pharmacy'), ('department', 'ilike', 'pharmacist')]"/>
                <filter string="Receptionist" name="filter_receptionist" domain="[('department', 'ilike', 'reception')]"/>
                <filter string="Doctor" name="filter_doctor" domain="[('department', 'ilike', 'doctor')]"/>
                <filter string="HR" name="filter_hr" domain="['|', ('department', 'ilike', 'hr'), ('department', 'ilike', 'human resources')]"/>
                <filter string="Admin" name="filter_admin" domain="['&amp;', '|', ('department', 'ilike', 'admin'), ('department', 'ilike', 'administration'), ('department', 'not ilike', 'super')]"/>
                <filter string="Super Admin" name="filter_super_admin" domain="[('department', 'ilike', 'super admin')]"/>
                <filter string="Asset / Maintenance" name="filter_asset" domain="['|', ('department', 'ilike', 'asset'), ('department', 'ilike', 'maintenance')]"/>
                <separator/>
                <filter string="Waiting Approval" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Partially Fulfilled" name="filter_partial" domain="[('state', '=', 'partial')]"/>
                <filter string="Ready for Pickup" name="filter_ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Ordered" name="filter_ordered" domain="[('state', '=', 'ordered')]"/>
                <group>
                    <filter string="Department" name="group_department" context="{'group_by': 'department'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Item" name="group_item" context="{'group_by': 'item_id'}"/>
                    <filter string="Requested By" name="group_user" context="{'group_by': 'requested_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Purchase Request -->
    <record id="action_asset_purchase_request" model="ir.actions.act_window">
        <field name="name">Item Request</field>
        <field name="res_model">hospital.asset.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requested_by_id', '=', uid)]</field>
        <field name="context">{'default_requested_by_id': uid}</field>
        <field name="search_view_id" ref="view_asset_purchase_request_search"/>
    </record>

    <record id="action_asset_purchase_request_manager" model="ir.actions.act_window">
        <field name="name">All Item Requests</field>
        <field name="res_model">hospital.asset.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_purchase_request_search"/>
        <field name="context">{'search_default_filter_submitted': 1}</field>
    </record>

    <record id="action_pharmacy_item_request" model="ir.actions.act_window">
        <field name="name">Item Request</field>
        <field name="res_model">hospital.asset.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('department', 'ilike', 'pharmacy'), ('department', 'ilike', 'pharmacist')]</field>
        <field name="context">{'search_default_filter_pharmacy': 1}</field>
        <field name="search_view_id" ref="view_asset_purchase_request_search"/>
    </record>

    <!-- Router Action to direct Pharmacy vs General/Asset users -->
    <record id="action_asset_purchase_request_router" model="ir.actions.server">
        <field name="name">Item Request</field>
        <field name="model_id" ref="model_hospital_asset_purchase_request"/>
        <field name="state">code</field>
        <field name="code">
if env.user.has_group('hospital_management.group_hospital_pharmacist') and not env.user.has_group('hospital_hr_asset.group_hospital_asset_manager'):
    action = env.ref('hospital_hr_asset.action_pharmacy_item_request').sudo().read()[0]
else:
    action = env.ref('hospital_hr_asset.action_asset_purchase_request').sudo().read()[0]
        </field>
    </record>

    <record id="view_asset_purchase_request_list" model="ir.ui.view">
        <field name="name">hospital.asset.purchase.request.list</field>
        <field name="model">hospital.asset.purchase.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="department" widget="badge"/>
                <field name="requested_by_id"/>
                <field name="item_id"/>
                <field name="quantity"/>
                <field name="available_stock" string="In-Stock" groups="hospital_hr_asset.group_hospital_asset_manager" decoration-danger="available_stock &lt; quantity" decoration-success="available_stock &gt;= quantity"/>
                <field name="request_date" string="Date &amp; Time"/>
                <field name="state" widget="badge" 
                    decoration-info="state == 'submitted'"
                    decoration-warning="state in ('ordered', 'partial')"
                    decoration-primary="state == 'ready'"
                    decoration-success="state == 'received'"
                    decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_purchase_request_form" model="ir.ui.view">
        <field name="name">hospital.asset.purchase.request.form</field>
        <field name="model">hospital.asset.purchase.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,partial,ready,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_outward" type="object" class="oe_stat_button" icon="fa-truck" invisible="outward_id == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Outward</span>
                                <span class="o_stat_value"><field name="delivered_qty"/> Delivered</span>
                            </div>
                        </button>
                        <button name="action_view_purchase_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="purchase_id == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Purchase Order</span>
                                <span class="o_stat_value"><field name="ordered_qty"/> on Order</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1 invisible="name != 'New'">Item Request</h1>
                        <h1 invisible="name == 'New'"><field name="name" readonly="1"/></h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="requested_by_id" readonly="1" force_save="1"/>
                            <field name="request_date" string="Request Date &amp; Time" readonly="1" force_save="1"/>
                            <field name="department" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="item_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="quantity" readonly="state != 'draft'"/>
                            <field name="available_stock" string="Current In-Stock" readonly="1" groups="hospital_hr_asset.group_hospital_asset_manager" decoration-danger="available_stock &lt; quantity" decoration-success="available_stock &gt;= quantity"/>
                        </group>
                    </group>
                    <group style="margin-left: 20px;">
                        <field name="reason" readonly="state != 'draft'"/>
                        <field name="po_id" invisible="1"/>
                    </group>

                    <group string="Fulfillment &amp; Procurement Tracking" style="margin-left: 20px;" invisible="state in ('draft', 'submitted')">
                        <group>
                            <field name="delivered_qty" string="Delivered Quantity" readonly="1"/>
                            <field name="ordered_qty" string="Quantity on Order" readonly="1"/>
                            <field name="remaining_qty" string="Remaining to Deliver" readonly="1"/>
                        </group>
                        <group>
                            <field name="outward_id" readonly="1" invisible="outward_id == False"/>
                            <field name="purchase_id" readonly="1" invisible="purchase_id == False"/>
                        </group>
                    </group>
                    
                    <!-- Action Buttons at bottom as requested by UI rules -->
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2">
                        <!-- Employee Buttons -->
                        <button name="action_submit" string="Submit Request" type="object" class="btn-primary" invisible="state != 'draft' or requested_by_id != uid"/>
                        
                        <!-- Manager Buttons -->
                        <button name="action_accept_ready" string="Accept (In Stock &amp; Ready)" type="object" class="btn-success" invisible="state != 'submitted' or available_stock &lt; quantity" groups="hospital_hr_asset.group_hospital_asset_manager"/>
                        <button name="action_open_split_wizard" string="Partial Deliver &amp; Order Rest..." type="object" class="btn-primary" invisible="state != 'submitted' or available_stock &lt;= 0 or available_stock &gt;= quantity" groups="hospital_hr_asset.group_hospital_asset_manager"/>
                        <button name="action_approve_order" string="Approve (Needs Ordering)" type="object" class="btn-warning" invisible="state != 'submitted'" groups="hospital_hr_asset.group_hospital_asset_manager"/>
                        <button name="action_deliver_remaining" string="Deliver Remaining Items" type="object" class="btn-success" invisible="state != 'partial' or remaining_qty &lt;= 0" groups="hospital_hr_asset.group_hospital_asset_manager"/>
                        <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state != 'submitted'" groups="hospital_hr_asset.group_hospital_asset_manager"/>
                        
                        <!-- Close Button -->
                        <button string="Close" type="button" class="btn-secondary btn-custom-close-request"/>
                    </div>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Split Wizard Form View -->
    <record id="view_hospital_asset_request_split_wizard_form" model="ir.ui.view">
        <field name="name">hospital.asset.request.split.wizard.form</field>
        <field name="model">hospital.asset.request.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Partial Delivery &amp; Purchase Allocation">
                <sheet>
                    <div class="alert alert-info" role="alert" style="margin-bottom: 15px;">
                        <strong>Partial Stock Available:</strong> Adjust how many units to deliver immediately from in-hand stock, and how many units to order from the vendor.
                    </div>
                    <group>
                        <group string="Request Summary">
                            <field name="item_id"/>
                            <field name="total_requested"/>
                            <field name="available_stock"/>
                        </group>
                        <group string="Allocation Split">
                            <field name="deliver_qty" string="Deliver Now (From In-Stock)" class="fw-bold text-success"/>
                            <field name="order_qty" string="Order from Vendor (Purchase Order)" class="fw-bold text-primary"/>
                            <field name="supplier_id" placeholder="Select supplier..."/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirm Allocation" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Asset Purchase Intent List View -->
    <record id="view_asset_purchase_intent_list" model="ir.ui.view">
        <field name="name">hospital.asset.purchase.intent.list</field>
        <field name="model">hospital.pharmacy.purchase</field>
        <field name="arch" type="xml">
            <list string="Purchase Intent List" limit="14">
                <field name="name" string="Purchase No."/>
                <field name="medicine_names" string="Product Name"/>
                <field name="supplier_id" string="Supplier Name"/>
                <field name="invoice_date"/>
                <field name="purchase_type"/>
                <field name="invoice_status" widget="badge" decoration-success="invoice_status == 'successful'" decoration-warning="invoice_status == 'pending'" invisible="state != 'done'"/>
            </list>
        </field>
    </record>

    <!-- Asset Purchase Orders List View -->
    <record id="view_asset_purchase_order_list" model="ir.ui.view">
        <field name="name">hospital.asset.purchase.order.list</field>
        <field name="model">hospital.pharmacy.purchase</field>
        <field name="arch" type="xml">
            <list string="Purchase Orders List" limit="14">
                <field name="name" string="Purchase No."/>
                <field name="medicine_names" string="Product Name"/>
                <field name="supplier_id" string="Supplier Name"/>
                <field name="invoice_date"/>
                <field name="purchase_type"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
                <field name="invoice_status" widget="badge" decoration-success="invoice_status == 'successful'" decoration-warning="invoice_status == 'pending'" invisible="state != 'done'"/>
            </list>
        </field>
    </record>

    <!-- Asset Purchase Intent Action -->
    <record id="action_asset_purchase_intent" model="ir.actions.act_window">
        <field name="name">Purchase Intent</field>
        <field name="res_model">hospital.pharmacy.purchase</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_type', '=', 'asset'), ('state', '=', 'intent')]</field>
        <field name="context">{'default_order_type': 'asset', 'default_state': 'intent'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_asset_purchase_intent_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_pharmacy_purchase_form')})]"/>
    </record>

    <!-- Asset Purchase Orders Action -->
    <record id="action_asset_purchase_order" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">hospital.pharmacy.purchase</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'intent')]</field>
        <field name="context">{'default_order_type': 'asset', 'default_state': 'draft'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_asset_purchase_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_pharmacy_purchase_form')})]"/>
    </record>

    <!-- Legacy Action Alias -->
    <record id="action_asset_po" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">hospital.pharmacy.purchase</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_type', '=', 'asset'), ('state', '!=', 'intent')]</field>
        <field name="context">{'default_order_type': 'asset', 'default_state': 'draft'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_asset_purchase_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_pharmacy_purchase_form')})]"/>
    </record>

    <!-- Legacy Model Views -->
    <record id="view_asset_po_list" model="ir.ui.view">
        <field name="name">hospital.asset.po.list</field>
        <field name="model">hospital.asset.po</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_asset_po_form" model="ir.ui.view">
        <field name="name">hospital.asset.po.form</field>
        <field name="model">hospital.asset.po</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,received"/>
                </header>
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1><field name="name"/></h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="vendor_id"/>
                            <field name="order_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="item_id"/>
                                    <field name="request_id" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2" style="margin-right: 20px;">
                        <button name="action_confirm" string="Confirm Order" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_receive" string="Receive Products (Inward)" type="object" class="btn-success" invisible="state != 'confirmed'"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Asset Purchase Invoices Action -->
    <record id="action_asset_purchase_invoice" model="ir.actions.act_window">
        <field name="name">Purchase Invoices</field>
        <field name="res_model">hospital.pharmacy.purchase.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending')]</field>
        <field name="context">{'default_state': 'pending'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hospital_management.view_hospital_pharmacy_purchase_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_pharmacy_purchase_invoice_form')})]"/>
    </record>

    <!-- Asset Payments Action -->
    <record id="action_asset_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">hospital.pharmacy.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_group_vendor': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hospital_management.view_hospital_pharmacy_payment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_management.view_hospital_pharmacy_payment_form')})]"/>
    </record>

    <!-- Inward -->
    <record id="action_asset_inward" model="ir.actions.act_window">
        <field name="name">Inward</field>
        <field name="res_model">hospital.asset.inward</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_asset_inward_list" model="ir.ui.view">
        <field name="name">hospital.asset.inward.list</field>
        <field name="model">hospital.asset.inward</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                
                <field name="po_id"/>
                <field name="vendor_id"/>
                <field name="date_received"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_asset_inward_form" model="ir.ui.view">
        <field name="name">hospital.asset.inward.form</field>
        <field name="model">hospital.asset.inward</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1><field name="name"/>
                </h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="po_id"/>
                            <field name="vendor_id"/>
                        </group>
                        <group>
                            <field name="date_received"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items Received">
                            <field name="line_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="item_id" />
                                    <field name="requested_qty" readonly="1" force_save="1" />
                                    <field name="approved_qty" readonly="1" force_save="1" />
                                    <field name="received_qty" />
                                    <field name="damaged_qty" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2" style="margin-right: 20px;">
                        <button string="Close" type="button" class="btn-secondary btn-custom-close-request"/>
                        <button name="action_view_invoice" string="View Invoice" type="object" class="btn-secondary" invisible="state != 'done'"/>
                        <button name="action_validate" string="Validate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Outward -->
    <record id="view_asset_outward_search" model="ir.ui.view">
        <field name="name">hospital.asset.outward.search</field>
        <field name="model">hospital.asset.outward</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="assigned_to"/>
                <field name="department"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Pharmacy" name="filter_pharmacy" domain="['|', ('department', 'ilike', 'pharmacy'), ('department', 'ilike', 'pharmacist')]"/>
                <filter string="Receptionist" name="filter_receptionist" domain="[('department', 'ilike', 'reception')]"/>
                <filter string="Doctor" name="filter_doctor" domain="[('department', 'ilike', 'doctor')]"/>
                <group>
                    <filter string="Department" name="group_department" context="{'group_by': 'department'}"/>
                    <filter string="Assigned To" name="group_user" context="{'group_by': 'assigned_to'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date Outward" name="group_date" context="{'group_by': 'date_outward'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_outward" model="ir.actions.act_window">
        <field name="name">Outward</field>
        <field name="res_model">hospital.asset.outward</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_outward_search"/>
    </record>

    <record id="view_asset_outward_list" model="ir.ui.view">
        <field name="name">hospital.asset.outward.list</field>
        <field name="model">hospital.asset.outward</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="assigned_to"/>
                <field name="department" widget="badge"/>
                <field name="date_outward"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_asset_outward_form" model="ir.ui.view">
        <field name="name">hospital.asset.outward.form</field>
        <field name="model">hospital.asset.outward</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1><field name="name"/></h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="assigned_to"/>
                            <field name="department" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="date_outward"/>
                            <field name="request_id" invisible="request_id == False" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <group style="margin-left: 20px;">
                        <group string="Items Assigned">
                            <field name="line_ids" nolabel="1" readonly="state == 'done'" colspan="2">
                                <list editable="bottom">
                                    <field name="item_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </group>
                        <group></group>
                    </group>
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2" style="margin-right: 20px;">
                        <button string="Close" type="button" class="btn-secondary btn-custom-close-request"/>
                        <button name="action_validate" string="Validate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Damage -->
    <record id="action_asset_damage" model="ir.actions.act_window">
        <field name="name">Damaged &amp; Expiry</field>
        <field name="res_model">hospital.asset.damage</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_asset_damage_list" model="ir.ui.view">
        <field name="name">hospital.asset.damage.list</field>
        <field name="model">hospital.asset.damage</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                
                <field name="item_id"/>
                <field name="quantity"/>
                <field name="date"/>
                <field name="source_document"/>
                <field name="po_id"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>
    <record id="view_asset_damage_form" model="ir.ui.view">
        <field name="name">hospital.asset.damage.form</field>
        <field name="model">hospital.asset.damage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title" style="margin-left: 20px;">
                        <h1><field name="name"/>
                </h1>
                    </div>
                    <group style="margin-left: 20px;">
                        <group>
                            <field name="item_id"/>
                            <field name="quantity"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="source_document"/>
                            <field name="po_id"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <div class="d-flex justify-content-end gap-2 mt-4 mb-2" style="margin-right: 20px;">
                        <button string="Close" type="button" class="btn-secondary btn-custom-close-request"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>






