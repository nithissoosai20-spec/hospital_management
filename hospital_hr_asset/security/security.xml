<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hospital Asset Manager -->
    <record id="group_hospital_asset_manager" model="res.groups">
        <field name="name">Asset Manager</field>
        <field name="sequence">95</field>
        <field name="privilege_id" ref="hospital_management.privilege_hospital_management"/>
        <field name="implied_ids" eval="[
            (4, ref('hospital_management.group_hospital_user')),
            (4, ref('maintenance.group_equipment_manager'))
        ]"/>
        <field name="comment">
            Asset Manager with access to hospital asset and maintenance management.
        </field>
    </record>

    <!-- Hospital Admin inherits Asset Manager -->
    <record id="hospital_management.group_hospital_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hospital_asset_manager'))]"/>
    </record>
    
</odoo>