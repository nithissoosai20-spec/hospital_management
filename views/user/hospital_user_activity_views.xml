<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ================================================= -->
    <!-- USER ACTIVITY LIST -->
    <!-- ================================================= -->

    <record id="view_hospital_user_activity_list" model="ir.ui.view">

        <field name="name">hospital.user.activity.list</field>
        <field name="model">hospital.user.activity</field>

        <field name="arch" type="xml">

            <list create="0" delete="0">

                <field name="activity_date"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="description"/>
                <field name="performed_by_id"/>
                <field name="field_name"/>
                <field name="previous_value"/>
                <field name="new_value"/>
                <field name="status"/>
                <field name="ip_address"/>

            </list>

        </field>

    </record>


    <!-- ================================================= -->
    <!-- USER ACTIVITY FORM -->
    <!-- ================================================= -->

    <record id="view_hospital_user_activity_form" model="ir.ui.view">

        <field name="name">hospital.user.activity.form</field>
        <field name="model">hospital.user.activity</field>

        <field name="arch" type="xml">

            <form create="0" edit="0" delete="0">

                <sheet>

                    <group string="Activity">

                        <group>

                            <field name="activity_date"/>
                            <field name="user_id"/>
                            <field name="action"/>
                            <field name="status"/>

                        </group>

                        <group>

                            <field name="performed_by_id"/>
                            <field name="ip_address"/>
                            <field name="user_agent"/>

                        </group>

                    </group>


                    <group string="Description">

                        <field name="description"/>

                    </group>


                    <group string="Change Details">

                        <group>

                            <field name="field_name"/>
                            <field name="previous_value"/>

                        </group>

                        <group>

                            <field name="new_value"/>

                        </group>

                    </group>


                    <group string="Metadata">

                        <field name="metadata"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ================================================= -->
    <!-- USER ACTIVITY ACTION -->
    <!-- ================================================= -->

    <record id="action_hospital_user_activity" model="ir.actions.act_window">

        <field name="name">User Activities</field>
        <field name="res_model">hospital.user.activity</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>
