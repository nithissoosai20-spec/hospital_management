<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hospital_pharmacy_bill" model="ir.actions.report">
        <field name="name">Pharmacy Bill</field>
        <field name="model">hospital.pharmacy.bill</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_hospital_a4"/>
        <field name="report_name">hospital_management.report_hospital_pharmacy_bill</field>
        <field name="report_file">hospital_management.report_hospital_pharmacy_bill</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_pharmacy_bill"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hospital_pharmacy_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
<style>
            /* Hide Odoo default footer in PDF and HTML preview */
            .o_report_footer, footer, .o_footer,
            #wkhtmltopdf-footer, .footer-block { display: none !important; }
            /* A4 print settings */
            @media print {
                .o_report_footer, footer, .o_footer { display: none !important; }
                body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

            body, .page, .article {
                margin: 0 !important;
                padding: 0 !important;
            }
            }
        </style>
                    <div class="page" style="position: relative; width: 100%; min-height: 297mm; z-index: 1; font-family: Arial, sans-serif;">
                        <!-- Edge-to-Edge Background, Footer Cropped via CSS Background -->
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 210mm; background-image: url('/hospital_management/static/src/img/purchase_bg.png'); background-size: 100% 297mm; background-position: top left; background-repeat: no-repeat; z-index: -2;"></div>
                        
                        
                        
                        
                        <!-- Content -->
                        <div style="padding-top: 65mm; padding-left: 15mm; padding-right: 15mm; padding-bottom: 30mm;">
                            
                            <div class="row mb-4 pt-4">
                                <div class="col-6">
                                    <h4 style="color: #1e3a8a;"><strong>Pharmacy Bill: </strong> <span t-field="doc.name"/></h4>
                                    <t t-if="doc.customer_type == 'patient'">
                                        <strong>Patient:</strong> <span t-field="doc.patient_id.name"/><br/>
                                        <strong>UHID:</strong> <span t-field="doc.patient_id.patient_id"/>
                                    </t>
                                    <t t-else="">
                                        <strong>Customer:</strong> <span t-field="doc.walkin_name"/><br/>
                                        <strong>Phone:</strong> <span t-field="doc.walkin_phone"/>
                                    </t>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Date:</strong> <span t-field="doc.create_date" t-options='{"widget": "datetime", "format": "dd-MMM-yyyy HH:mm"}'/><br/>
                                    <strong>Doctor:</strong> <span t-field="doc.doctor_id.name"/><br/>
                                    <strong>Department:</strong> <span t-field="doc.doctor_department_id.name"/><br/>
                                    <strong>Payment Mode:</strong> <span style="text-transform:uppercase;" t-field="doc.payment_mode"/>
                                </div>
                            </div>

                            <table class="table table-sm mt-4" style="width: 100%; margin-bottom: 1rem; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">S.No</th>
                                        <th style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Item Name</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Qty</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Price</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">CGST</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">SGST</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">IGST</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sno" t-value="1"/>
                                    <t t-foreach="doc.line_ids" t-as="line">
                                        <tr>
                                            <td style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><t t-esc="sno"/></td>
                                            <td style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.medicine_name"/></td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.qty"/></td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.mrp"/></td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;">0.00</td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;">0.00</td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;">0.00</td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.amount"/></td>
                                        </tr>
                                        <t t-set="sno" t-value="sno + 1"/>
                                    </t>
                                </tbody>
                            </table>

                            <div class="row justify-content-end mt-3">
                                <div class="col-5">
                                    <table class="table table-sm table-borderless" style="width: 100%;">
                                        <tr>
                                            <td style="padding-top: 5px;"><strong>Sub Total:</strong></td>
                                            <td class="text-end" style="padding-top: 5px;"><span t-field="doc.subtotal"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding-top: 5px;"><strong>Discount:</strong></td>
                                            <td class="text-end" style="padding-top: 5px;"><span t-field="doc.bill_discount"/></td>
                                        </tr>
                                        <tr style="border-top: 1px solid black;">
                                            <td style="padding-top: 10px;"><strong>Net Amount:</strong></td>
                                            <td class="text-end" style="padding-top: 10px;">
                                                <strong><span t-field="doc.total_amount"/></strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="row" style="margin-top: 50px;">
                                <div class="col-8">
                                </div>
                                <div class="col-3 text-center">
                                    <br/><br/><br/>
                                    <strong>Signature</strong>
                                </div>
                            </div>

                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
