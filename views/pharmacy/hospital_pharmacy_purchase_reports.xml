<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="paperformat_purchase_invoice" model="report.paperformat">
        <field name="name">Purchase Invoice Paperformat</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking">True</field><field name="dpi">96</field>
    </record>

    <!-- Purchase Order Report Action -->
    <record id="action_report_pharmacy_purchase_order" model="ir.actions.report">
        <field name="name">Purchase Order</field>
        <field name="model">hospital.pharmacy.purchase</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_pharmacy_purchase_order</field>
        <field name="report_file">hospital_management.report_pharmacy_purchase_order</field>
        <field name="print_report_name">'Purchase Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_hospital_pharmacy_purchase"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_purchase_invoice"/>
    </record>

    <!-- Purchase Order Report Template -->
    <template id="report_pharmacy_purchase_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
               
                    <style>
                        .o_report_footer, footer, .o_footer, #wkhtmltopdf-footer, .footer-block { display: none !important; }
                        @media print {
                            .o_report_footer, footer, .o_footer { display: none !important; }
                            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                        }
                    </style>

                    <div class="article" style="margin: 0; padding: 0; font-family: Arial, sans-serif; position: relative; width: 210mm; height: 297mm; min-height: 297mm; overflow: hidden; box-sizing: border-box;">
                        <div style="position: absolute; top: 3mm; right: 6mm; bottom: 3mm; left: 3mm; width: auto; height: auto; z-index: 0; overflow: hidden;">
                            <img src="/hospital_management/static/src/img/purchase_bg.png" style="display: block; width: 100%; height: 100%; max-width: none; object-fit: fill;"/>
                        </div>
                        <div class="row mb-4 pt-4" style="position: relative; z-index: 1; ">
                                <div class="col-6">
                                    <h4 style="color: #1e3a8a;"><strong>Purchase Order: </strong> <span t-field="o.name"/></h4>
                                    <strong>Supplier:</strong><br/>
                                    <span t-if="o.supplier_id" t-field="o.supplier_id.name"/>
                                    <span t-if="not o.supplier_id" t-field="o.supplier_name"/>
                                    <br/>
                                    <span t-if="o.mobile_number"><strong>Mobile:</strong> <span t-field="o.mobile_number"/><br/></span>
                                    <span t-if="o.gst_no"><strong>GST No:</strong> <span t-field="o.gst_no"/><br/></span>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Order Date:</strong> <span t-field="o.invoice_date"/><br/>
                                    <strong>Order No:</strong> <span t-field="o.name"/><br/>
                                    <span t-if="o.payment_terms"><strong>Payment Terms:</strong> <span t-field="o.payment_terms"/><br/></span>
                                </div>
                            </div>

                            <table class="table table-sm mt-4" style="width: 100%; margin-bottom: 1rem; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Medicine</th>
                                        <th style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Batch No</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Qty</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Price</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Disc(%)</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">GST(%)</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids" t-as="line">
                                        <tr>
                                            <td style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.medicine_id.medicine_name"/></td>
                                            <td style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.batch_no"/></td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.qty"/></td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.purchase_price"/></td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.discount_percent"/></td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-esc="line.cgst_percent + line.sgst_percent + line.igst_percent"/></td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.amount"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <div class="row justify-content-end mt-3">
                                <div class="col-5">
                                    <table class="table table-sm table-borderless" style="width: 100%;">
                                        <tr style="border-top: 1px solid black;">
                                            <td style="padding-top: 10px;"><strong>Total Amount</strong></td>
                                            <td class="text-end" style="padding-top: 10px;">
                                                <strong><span t-esc="'%.2f' % sum(line.amount for line in o.line_ids)"/></strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="row" style="margin-top: 50px;">
                                <div class="col-8">
                                </div>
                                <div class="col-3 text-center">
                                    <br/><br/><br/>
                                    <strong>Signature</strong>
                                </div>
                            </div>
                            
                        
                    </div>
                
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_pharmacy_purchase_invoice" model="ir.actions.report">
