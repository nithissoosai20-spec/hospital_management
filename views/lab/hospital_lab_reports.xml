<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hospital_lab_receipt" model="ir.actions.report">
        <field name="name">Lab Fee Receipt</field>
        <field name="model">hospital.lab.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_hospital_a4"/>
        <field name="report_name">hospital_management.report_hospital_lab_receipt</field>
        <field name="report_file">hospital_management.report_hospital_lab_receipt</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_lab_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hospital_lab_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="position: relative; width: 100%; min-height: 297mm; z-index: 1; font-family: Arial, sans-serif;">
                        <!-- Background Image -->
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;">
                            <img src="/hospital_management/static/src/img/bill.png" style="width: 100%; height: 297mm; object-fit: cover;"/>
                        </div>
                        
                        <!-- Content -->
                        <div style="padding-top: 65mm; padding-left: 15mm; padding-right: 15mm; padding-bottom: 30mm;">
                            
                            <div style="text-align:center; margin:0 0 20px 0;">
                                <h2 style="margin:0; padding:0; font-size:24px; font-weight:bold; color:#1e3a8a;">
                                    LAB FEE RECEIPT
                                </h2>
                            </div>
                            
                            <div class="row mb-4 pt-4">
                                <div class="col-6">
                                    <strong>Lab Reference:</strong> <span t-field="doc.name"/><br/>
                                    <strong>Patient:</strong> <span t-field="doc.patient_id.name"/><br/>
                                    <strong>UHID:</strong> <span t-field="doc.patient_id.patient_id"/>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Date:</strong> <span t-field="doc.appointment_date"/><br/>
                                    <strong>Doctor:</strong> <span t-field="doc.doctor_id.name"/><br/>
                                    <strong>Payment Mode:</strong> <span style="text-transform:uppercase;" t-field="doc.payment_mode"/>
                                </div>
                            </div>

                            <table class="table table-sm mt-4" style="width: 100%; margin-bottom: 1rem; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">S.No</th>
                                        <th style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Code</th>
                                        <th style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Lab Test Name</th>
                                        <th style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Category</th>
                                        <th style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Sample</th>
                                        <th class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: 2px solid black !important; border-bottom: 2px solid black !important;">Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sno" t-value="1"/>
                                    <t t-foreach="doc.line_ids" t-as="line">
                                        <tr>
                                            <td style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><t t-esc="sno"/></td>
                                            <td style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.test_code"/></td>
                                            <td style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.lab_test_id"/></td>
                                            <td style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.category"/></td>
                                            <td style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.sample_type"/></td>
                                            <td class="text-end" style="padding: 8px 4px; border-left: none; border-right: none; border-top: none; border-bottom: 1px solid black !important;"><span t-field="line.price"/></td>
                                        </tr>
                                        <t t-set="sno" t-value="sno + 1"/>
                                    </t>
                                </tbody>
                            </table>

                            <div class="row justify-content-end mt-3">
                                <div class="col-5">
                                    <table class="table table-sm table-borderless" style="width: 100%;">
                                        <tr style="border-top: 1px solid black;">
                                            <td style="padding-top: 10px;"><strong>Total Amount:</strong></td>
                                            <td class="text-end" style="padding-top: 10px;">
                                                <strong><span t-field="doc.amount"/></strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            
                            

                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
