<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- LAB TEST MASTER -->

    <record id="view_hospital_lab_test_list"
            model="ir.ui.view">

        <field name="name">hospital.lab.test.list</field>
        <field name="model">hospital.lab.test</field>

        <field name="arch" type="xml">

            <list>

                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="sample_type"/>
                <field name="price"/>
                <field name="turnaround_time"/>
                <field name="active"/>

            </list>

        </field>

    </record>


    <record id="view_hospital_lab_test_form"
            model="ir.ui.view">

        <field name="name">hospital.lab.test.form</field>
        <field name="model">hospital.lab.test</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name"/>
                        </h1>

                    </div>

                    <group>

                        <group string="Test Information">

                            <field name="code"/>
                            <field name="category"/>
                            <field name="sample_type"/>

                        </group>

                        <group string="Pricing">

                            <field name="price"/>
                            <field name="turnaround_time"/>
                            <field name="active"/>

                        </group>

                    </group>

                    <group string="Notes">

                        <field name="notes"/>

                    </group>

                
                    
                </sheet>

            </form>

        </field>

    </record>


    <!-- LAB APPOINTMENT LIST -->

    <record id="view_hospital_lab_appointment_list"
            model="ir.ui.view">

        <field name="name">hospital.lab.appointment.list</field>

        <field name="model">hospital.lab.appointment</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>
                <field name="patient_id"/>
                <field name="lab_test_id"/>
                <field name="appointment_date"/>
                <field name="appointment_time"
                       widget="float_time"/>

                <field name="doctor_id"/>
                <field name="priority"
                       widget="badge"/>

                <field name="amount"/>

                <field name="payment_status"
                       widget="badge"/>

                <field
                    name="receipt_ready"
                    invisible="1"
                />


                <field name="state"
                       widget="badge"/>

            </list>

        </field>

    </record>


    <!-- LAB APPOINTMENT FORM -->

    <record id="view_hospital_lab_appointment_form"
            model="ir.ui.view">

        <field name="name">hospital.lab.appointment.form</field>
        <field name="model">hospital.lab.appointment</field>

        <field name="arch" type="xml">

            <form>

                <!-- HEADER -->

                <header>

                    
                    <!-- SAVE -->
                    
                    
                    <button
                        name="action_collect_sample"
                        type="object"
                        string="Collect Sample"
                        invisible="state != 'scheduled'"
                    />

                    <button
                        name="action_start_processing"
                        type="object"
                        string="Start Processing"
                        invisible="state != 'sample_collected'"
                    />

                    <button
                        name="action_complete"
                        type="object"
                        string="Complete"
                        class="btn-success"
                        invisible="state != 'processing'"
                    />

                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-secondary"
                        icon="fa-times"
                        invisible="state in ('completed', 'cancelled')"
                    />

                </header>


                <!-- MAIN CONTENT -->

                <sheet>

                    <!-- PATIENT + APPOINTMENT INFORMATION -->

                    <div
                        style="
                            border:1px solid #e5e5e5;
                            border-radius:8px;
                            padding:12px 16px;
                            margin-bottom:10px;
                            background:#ffffff;
                        "
                    >

                        <group col="2">

                            <!-- PATIENT INFORMATION -->

                            <group string="PATIENT INFORMATION">

                                <field
                                    name="patient_id"
                                    readonly="1"
                                />

                                <field
                                    name="hospital_appointment_id"
                                    readonly="1"
                                />

                                <field
                                    name="doctor_id"
                                    string="Referring Doctor"
                                    readonly="1"
                                />

                            </group>


                            <!-- APPOINTMENT INFORMATION -->

                            <group string="APPOINTMENT INFORMATION">

                                <field
                                    name="appointment_date"
                                    readonly="1"
                                />

                                <field
                                    name="appointment_time"
                                    widget="float_time"
                                    readonly="1"
                                />

                                <field
                                    name="priority"
                                    readonly="1"
                                />

                            </group>

                        </group>

                    </div>


                    <!-- SELECTED LABORATORY TESTS -->
                    <!-- FULL WIDTH -->

                    <group string="SELECTED LABORATORY TESTS" col="1">

                        <field
                            name="line_ids"
                            nolabel="1"
                        >

                            <list
                                editable="bottom"
                                create="1"
                                delete="1"
                                class="hospital_lab_test_list"
                            >

                                <field
                                    name="lab_test_id"
                                    string="Lab Test"
                                    required="1"
                                />

                                <field
                                    name="test_code"
                                    string="Code"
                                    readonly="1"
                                />

                                <field
                                    name="category"
                                    string="Category"
                                    readonly="1"
                                />

                                <field
                                    name="sample_type"
                                    string="Sample Type"
                                    readonly="1"
                                />

                                <field
                                    name="price"
                                    string="Price"
                                    readonly="1"
                                />

                            </list>

                        </field>

                    </group>


                    <!-- PAYMENT INFORMATION -->
                    <!-- FULL WIDTH -->

                    <group string="PAYMENT INFORMATION" col="1">

                        <group col="3">

                            <field
                                name="amount"
                                string="Amount"
                                readonly="1"
                            />

                            <field
                                name="payment_mode"
                                string="Payment Mode"
                            />

                            <field
                                name="payment_status"
                                string="Payment Status"
                            />

                        </group>

                    </group>

                    <!-- PRINT LAB RECEIPT -->

                    <div class="hospital-lab-receipt-action">

                        <button
                            name="%(action_report_hospital_lab_receipt)d"
                            type="action"
                            string="Print Lab Receipt"
                            class="btn-primary"
                            icon="fa-print"
                            invisible="not receipt_ready"
                        />

                    </div>


                    <!-- LAB RESULT -->

                    <group
                        string="LABORATORY RESULT"
                        invisible="state not in ('processing', 'completed')"
                    >

                        <field name="result"/>

                        <field name="remarks"/>

                    </group>

                
                    
                
                    <div class="d-flex justify-content-end mt-4 mb-2">
                        <button
                        name="action_save_lab_appointment"
                        type="object"
                        string="Save"
                        class="btn-primary" style="margin-left: auto !important;"
                        icon="fa-save"
                    />
                    </div>
                </sheet>

            </form>

        </field>

    </record>    
    <!-- ACTIONS -->

    <record id="action_hospital_lab_appointments"
            model="ir.actions.act_window">

        <field name="name">Lab Appointments</field>

        <field name="res_model">hospital.lab.appointment</field>

        <field name="view_mode">list,form</field>

    </record>


    <record id="action_hospital_lab_tests"
            model="ir.actions.act_window">

        <field name="name">Lab Test Master</field>

        <field name="res_model">hospital.lab.test</field>

        <field name="view_mode">list,form</field>

    </record>


   
</odoo>