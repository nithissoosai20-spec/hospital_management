<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record
        id="view_hospital_lab_receipt_wizard_form"
        model="ir.ui.view"
    >

        <field name="name">hospital.lab.receipt.wizard.form</field>

        <field name="model">hospital.lab.receipt.wizard</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div
                        style="
                            text-align:center;
                            padding:10px 20px 5px 20px;
                        "
                    >

                        <div
                            style="
                                font-size:22px;
                                font-weight:700;
                                margin-bottom:15px;
                            "
                        >
                            Saved Successfully
                        </div>

                        <div
                            style="
                                font-size:16px;
                                font-weight:500;
                                margin-bottom:10px;
                            "
                        >
                            Lab appointment has been saved successfully.
                        </div>

                        <div
                            style="
                                font-size:17px;
                                font-weight:600;
                                margin-bottom:20px;
                            "
                        >
                            Do you want to print the receipt now?
                        </div>

                    </div>

                    <footer
                        style="
                            text-align:center;
                        "
                    >

                        <button
                            name="action_print_now"
                            string="Print Now"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"
                        />

                        <button
                            name="action_print_later"
                            string="Later"
                            type="object"
                            class="btn-secondary"
                            icon="fa-clock-o"
                        />

                    </footer>

                </sheet>

            </form>

        </field>

    </record>

</odoo>