<odoo>

    <template id="login_page" name="Hospital Login">

        <html>

            <head>

                <meta charset="utf-8"/>

                <meta name="viewport"
                      content="width=device-width, initial-scale=1"/>

                <title>Login</title>

                <link rel="stylesheet"
                      href="/hospital_management/static/src/css/login.css"/>

            </head>

            <body>

                <div class="hospital-login-page">

                    <div class="login-card">

                        <h1>Login</h1>

                        <form action="/login" method="post">

                            <input type="hidden"
                                   name="csrf_token"
                                   t-att-value="request.csrf_token()"/>

                            <div class="form-group">

                                <label for="email">
                                    Email address
                                </label>

                                <input type="email"
                                       id="email"
                                       name="email"
                                       placeholder="Enter email"/>

                            </div>

                            <div class="form-group">

                                <label for="password">
                                    Password
                                </label>

                                <input type="password"
                                       id="password"
                                       name="password"
                                       placeholder="Password"/>

                            </div>

                            <button type="submit">
                                Login
                            </button>

                        </form>

                    </div>

                </div>

            </body>

        </html>

    </template>

</odoo>