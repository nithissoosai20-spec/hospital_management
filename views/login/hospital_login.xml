<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="hospital_login_layout"
              inherit_id="web.login_layout"
              name="RIALKG Login Layout">

        <!-- Replace the complete Odoo default logo section -->
        <xpath expr="//div[hasclass('text-center') and hasclass('pb-3') and hasclass('border-bottom')]"
               position="replace">

            <div class="hospital-login-logo">

                <img src="/hospital_management/static/src/img/rialkg_login_logo.png"
                     alt="RIALKG Medical Center &amp; Hospital"/>

            </div>

        </xpath>

    </template>

</odoo>