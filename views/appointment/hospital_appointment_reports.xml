<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_hospital_a4" model="report.paperformat">
        <field name="name">Hospital A4</field>
        <field name="format">A4</field>
        <field name="page_width">0</field>
        <field name="page_height">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line">False</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_hospital_appointment_receipt" model="ir.actions.report">
        <field name="name">Appointment Receipt</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_hospital_a4"/>
        <field name="report_name">hospital_management.report_hospital_appointment_receipt</field>
        <field name="report_file">hospital_management.report_hospital_appointment_receipt</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_hospital_appointment_token" model="ir.actions.report">
        <field name="name">Appointment Token</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="hospital_management.paperformat_hospital_a4"/>
        <field name="report_name">hospital_management.report_hospital_appointment_token</field>
        <field name="report_file">hospital_management.report_hospital_appointment_token</field>
        <field name="binding_model_id" ref="hospital_management.model_hospital_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_hospital_appointment_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
<style>
            /* Hide Odoo default footer in PDF and HTML preview */
            .o_report_footer, footer, .o_footer,
            #wkhtmltopdf-footer, .footer-block { display: none !important; }
            /* A4 print settings */
            @media print {
                .o_report_footer, footer, .o_footer { display: none !important; }
                body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

            body, .page, .article {
                margin: 0 !important;
                padding: 0 !important;
            }
            }
        </style>
                    <div class="page" style="position: relative; width: 100%; min-height: 297mm; z-index: 1; font-family: Arial, sans-serif; font-size: 13px;">
                        <!-- Edge-to-Edge Background, Footer Cropped via CSS Background -->
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 210mm; background-image: url('/hospital_management/static/src/img/purchase_bg.png'); background-size: 100% 297mm; background-position: top left; background-repeat: no-repeat; z-index: -2;"></div>
                        
                        
                        

                        <div style="padding-top:  65mm; padding-left: 15mm; padding-right: 15mm; padding-bottom: 30mm;">

                            <div class="row pt-2" style="font-size: 12px; color: #333;">
                                <!-- Left Column: Patient -->
                                <div class="col-4">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Patient Name</div>
                                        <div class="col-7"><span t-field="doc.patient_name"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Mobile Number</div>
                                        <div class="col-7"><span t-field="doc.patient_phone"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Age / Gender</div>
                                        <div class="col-7">
                                            <t t-if="doc.patient_id.age">
                                                <span t-field="doc.patient_id.age"/> / 
                                            </t>
                                            <span style="text-transform: capitalize;" t-field="doc.new_patient_gender"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Middle Column: Doctor -->
                                <div class="col-4">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-center">Doctor</div>
                                        <div class="col-7"><span t-field="doc.doctor_id.name"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-center">Department</div>
                                        <div class="col-7"><span t-field="doc.department_id.name"/></div>
                                    </div>
                                </div>

                                <!-- Right Column: Appointment -->
                                <div class="col-4">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-end">Date / Time</div>
                                        <div class="col-7 text-end">
                                            <span t-field="doc.appointment_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                            <span t-field="doc.appointment_time_am_pm"/>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-end">OP Number</div>
                                        <div class="col-7 text-end"><span t-field="doc.patient_code"/></div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Token Number & Receipt Info -->
                            <div class="row mt-5">
                                <div class="col-12 text-center">
                                    <div style="font-size:14px; font-weight:bold; color:#555;">TOKEN NUMBER</div>
                                    <div style="font-size:36px; font-weight:bold; color:#1e3a8a; margin-top: 5px;">
                                        <span t-field="doc.token_number"/>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row mt-5 justify-content-center">
                                <div class="col-6">
                                    <table class="table table-sm table-borderless" style="border: 1px solid #ddd; font-size: 13px;">
                                        <tr style="border-bottom: 1px solid #ddd;">
                                            <td style="background-color: #f1f5f9; width: 50%;"><strong>Net Amount</strong></td>
                                            <td>&#8377; <span t-out="'%.2f' % doc.net_amount"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #ddd;">
                                            <td style="background-color: #f1f5f9;"><strong>Payment Mode</strong></td>
                                            <td style="text-transform: capitalize;"><span t-field="doc.payment_mode"/></td>
                                        </tr>
                                        <tr t-if="doc.transaction_id">
                                            <td style="background-color: #f1f5f9;"><strong>Transaction ID</strong></td>
                                            <td><span t-field="doc.transaction_id"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
    
    <template id="report_hospital_appointment_token">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <style>
                        /* Hide Odoo default footer in PDF and HTML preview */
                        .o_report_footer, footer, .o_footer,
                        #wkhtmltopdf-footer, .footer-block { display: none !important; }
                        /* A4 print settings */
                        @media print {
                            .o_report_footer, footer, .o_footer { display: none !important; }
                            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

            body, .page, .article {
                margin: 0 !important;
                padding: 0 !important;
            }
                        }
                    </style>
                    <div class="page" style="position: relative; width: 100%; min-height: 297mm; z-index: 1; font-family: Arial, sans-serif; font-size: 13px;">
                        <!-- Edge-to-Edge Background, Footer Cropped via CSS Background -->
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 210mm; background-image: url('/hospital_management/static/src/img/purchase_bg.png'); background-size: 100% 297mm; background-position: top left; background-repeat: no-repeat; z-index: -2;"></div>
                        
                        
                        

                        <div style="padding-top:  65mm; padding-left: 15mm; padding-right: 15mm; padding-bottom: 30mm;">

                            <!-- First Row: Patient, Doctor, Date -->
                            <div class="row pt-2" style="font-size: 12px; color: #333;">
                                <!-- Left Column: Patient -->
                                <div class="col-4">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Patient Name</div>
                                        <div class="col-7"><span t-field="doc.patient_name"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Mobile Number</div>
                                        <div class="col-7"><span t-field="doc.patient_phone"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Age / Gender</div>
                                        <div class="col-7">
                                            <t t-if="doc.patient_id.age">
                                                <span t-field="doc.patient_id.age"/> / 
                                            </t>
                                            <span style="text-transform: capitalize;" t-field="doc.new_patient_gender"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Middle Column: Doctor -->
                                <div class="col-4">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-center">Doctor</div>
                                        <div class="col-7"><span t-field="doc.doctor_id.name"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-center">Department</div>
                                        <div class="col-7"><span t-field="doc.department_id.name"/></div>
                                    </div>
                                </div>

                                <!-- Right Column: Appointment -->
                                <div class="col-4">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-end">Date / Time</div>
                                        <div class="col-7 text-end">
                                            <span t-field="doc.appointment_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                            <span t-field="doc.appointment_time_am_pm"/>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-end">Patient ID</div>
                                        <div class="col-7 text-end"><span t-field="doc.patient_id.patient_id"/></div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Second Row: Vitals at the same size as details -->
                            <div class="row mt-3" style="font-size: 12px; color: #333; border-top: 1px solid #ddd; padding-top: 15px;">
                                <div class="col-4">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold">Height</div>
                                        <div class="col-7">________</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-center">Weight</div>
                                        <div class="col-7">________</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="row mb-2">
                                        <div class="col-5 fw-bold text-end">BP / Temp</div>
                                        <div class="col-7 text-end">________ / ________</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Token Number Highlighted & Smaller -->
                            <div class="row mt-4">
                                <div class="col-12 text-center">
                                    <div style="display: inline-block; padding: 5px 15px; border: 2px solid #1e3a8a; border-radius: 5px; background-color: #f1f5f9;">
                                        <span style="font-size:12px; font-weight:bold; color:#555; margin-right: 10px;">TOKEN NUMBER:</span>
                                        <span style="font-size:18px; font-weight:bold; color:#1e3a8a;" t-field="doc.token_number"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
