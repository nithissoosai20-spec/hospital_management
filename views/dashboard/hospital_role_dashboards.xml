<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_hospital_reception_dashboard_form" model="ir.ui.view">

        <field name="name">hospital.reception.dashboard.form</field>
        <field name="model">hospital.reception.dashboard</field>

        <field name="arch" type="xml">

            <form create="0" edit="0" delete="0">

                <sheet style="height:100%;padding:0;margin:0;max-width:100%;">

                    <div class="rdb">

                        <!-- HEADER -->
                        <div class="rdb-header">
                            <div class="rdb-header-left">
                                <span class="rdb-title">🏥 Reception Dashboard</span>
                                <span class="rdb-subtitle">Welcome, Receptionist</span>
                            </div>
                        </div>

                        <!-- ROW 1 : 6 KPI TILES -->
                        <div class="rdb-row1">

                            <button name="%(action_hospital_appointment_today)d" type="action" class="rdb-tile rdb-blue">
                                <span class="rdb-tile-icon">📅</span>
                                <span class="rdb-tile-num"><field name="today_appointments" nolabel="1" readonly="1"/></span>
                                <span class="rdb-tile-lbl">Today's Appointments</span>
                            </button>

                            <button name="%(action_hospital_patient)d" type="action" class="rdb-tile rdb-green">
                                <span class="rdb-tile-icon">🧑‍⚕️</span>
                                <span class="rdb-tile-num"><field name="total_patients" nolabel="1" readonly="1"/></span>
                                <span class="rdb-tile-lbl">Total Patients</span>
                            </button>

                            <button name="%(action_hospital_token_patients_today)d" type="action" class="rdb-tile rdb-cyan">
                                <span class="rdb-tile-icon">🎫</span>
                                <span class="rdb-tile-num"><field name="today_token_patients" nolabel="1" readonly="1"/></span>
                                <span class="rdb-tile-lbl">Today's Tokens</span>
                            </button>

                            <button name="%(action_hospital_appointment_waiting)d" type="action" class="rdb-tile rdb-orange">
                                <span class="rdb-tile-icon">⏳</span>
                                <span class="rdb-tile-num"><field name="waiting_patients" nolabel="1" readonly="1"/></span>
                                <span class="rdb-tile-lbl">Waiting Patients</span>
                            </button>

                            <button name="%(action_hospital_appointment_pending_payment)d" type="action" class="rdb-tile rdb-red">
                                <span class="rdb-tile-icon">💳</span>
                                <span class="rdb-tile-num"><field name="pending_payments" nolabel="1" readonly="1"/></span>
                                <span class="rdb-tile-lbl">Pending Payments</span>
                            </button>

                            <button name="%(action_hospital_lab_appointments)d" type="action" class="rdb-tile rdb-purple"
                                    context="{'search_default_appointment_date': context_today()}">
                                <span class="rdb-tile-icon">🔬</span>
                                <span class="rdb-tile-num"><field name="today_lab_tests" nolabel="1" readonly="1"/></span>
                                <span class="rdb-tile-lbl">Today's Lab Tests</span>
                            </button>

                        </div>

                        <!-- ROW 2 : APPOINTMENT STATUS + PATIENTS + DOCTORS -->
                        <div class="rdb-row2">

                            <!-- APPOINTMENT STATUS -->
                            <div class="rdb-panel">
                                <div class="rdb-panel-hdr">📋 Appointment Status</div>
                                <div class="rdb-status-grid">

                                    <button name="%(action_hospital_appointment_booked)d" type="action" class="rdb-status-tile rdb-s-blue">
                                        <span class="rdb-s-num"><field name="booked_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="rdb-s-lbl">Booked</span>
                                    </button>

                                    <button name="%(action_hospital_appointment_waiting)d" type="action" class="rdb-status-tile rdb-s-orange">
                                        <span class="rdb-s-num"><field name="waiting_patients" nolabel="1" readonly="1"/></span>
                                        <span class="rdb-s-lbl">Waiting</span>
                                    </button>

                                    <button name="%(action_hospital_appointment_completed)d" type="action" class="rdb-status-tile rdb-s-green">
                                        <span class="rdb-s-num"><field name="completed_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="rdb-s-lbl">Completed</span>
                                    </button>

                                    <button name="%(action_hospital_appointment_cancelled)d" type="action" class="rdb-status-tile rdb-s-red">
                                        <span class="rdb-s-num"><field name="cancelled_appointments" nolabel="1" readonly="1"/></span>
                                        <span class="rdb-s-lbl">Cancelled</span>
                                    </button>

                                </div>
                            </div>

                            <!-- PATIENT REGISTRATION -->
                            <div class="rdb-panel">
                                <div class="rdb-panel-hdr">🧑‍⚕️ Patient Registration</div>
                                <div class="rdb-patient-body">
                                    <div class="rdb-patient-stats">
                                        <div class="rdb-pstat">
                                            <span class="rdb-pstat-num"><field name="today_patients" nolabel="1" readonly="1"/></span>
                                            <span class="rdb-pstat-lbl">Today</span>
                                        </div>
                                        <div class="rdb-pstat">
                                            <span class="rdb-pstat-num"><field name="total_patients" nolabel="1" readonly="1"/></span>
                                            <span class="rdb-pstat-lbl">Total</span>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>

                            <!-- DOCTOR AVAILABILITY -->
                            <div class="rdb-panel">
                                <div class="rdb-panel-hdr">👨‍⚕️ Doctor Availability</div>
                                <div class="rdb-doctor-list" style="padding: 10px;">
                                    <field name="doctor_status_ids" readonly="1">
                                        <list no_open="1" create="0" delete="0" edit="0" decoration-success="active == True" decoration-danger="active == False">
                                            <field name="name" string="Doctor Name"/>
                                            <field name="availability_status" string="Status"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>

                        <!-- ROW 3 : QUICK ACTIONS -->
                        <div class="rdb-row3" style="display: none;">

                            <button name="%(action_hospital_patient)d" type="action" class="rdb-action">
                                <span class="rdb-action-icon">🧑‍⚕️</span>
                                <strong>Patients</strong>
                                <span>Manage records</span>
                            </button>

                            <button name="%(action_hospital_appointment_today)d" type="action" class="rdb-action">
                                <span class="rdb-action-icon">📅</span>
                                <strong>Appointments</strong>
                                <span>Today's list</span>
                            </button>

                            <button name="%(action_hospital_token_patients_today)d" type="action" class="rdb-action">
                                <span class="rdb-action-icon">🎫</span>
                                <strong>Tokens</strong>
                                <span>Today's tokens</span>
                            </button>

                            <button name="%(action_hospital_appointment_pending_payment)d" type="action" class="rdb-action">
                                <span class="rdb-action-icon">💳</span>
                                <strong>Payments</strong>
                                <span>Pending dues</span>
                            </button>

                            <button name="%(action_hospital_lab_appointments)d" type="action" class="rdb-action"
                                    context="{'search_default_appointment_date': context_today()}">
                                <span class="rdb-action-icon">🔬</span>
                                <strong>Laboratory</strong>
                                <span>Today's tests</span>
                            </button>

                            <button name="%(action_hospital_appointment_booked)d" type="action" class="rdb-action">
                                <span class="rdb-action-icon">📌</span>
                                <strong>Booked</strong>
                                <span>Booked appointments</span>
                            </button>

                            <button name="%(action_hospital_appointment_completed)d" type="action" class="rdb-action">
                                <span class="rdb-action-icon">✅</span>
                                <strong>Completed</strong>
                                <span>Done appointments</span>
                            </button>

                            <button name="%(action_hospital_appointment_cancelled)d" type="action" class="rdb-action">
                                <span class="rdb-action-icon">❌</span>
                                <strong>Cancelled</strong>
                                <span>Cancelled list</span>
                            </button>

                        </div>

                    </div>

                </sheet>

            </form>

        </field>

    </record>


    <!-- Reception Dashboard Record -->
    <record id="reception_dashboard_record" model="hospital.reception.dashboard">
        <field name="name">Reception Dashboard</field>
    </record>

    <!-- Reception Dashboard Action -->
    <record id="action_hospital_reception_dashboard" model="ir.actions.act_window">
        <field name="name">Reception Dashboard</field>
        <field name="res_model">hospital.reception.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="reception_dashboard_record"/>
        <field name="target">current</field>
        <field name="view_id" ref="view_hospital_reception_dashboard_form"/>
    </record>


</odoo>