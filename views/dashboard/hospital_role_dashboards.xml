<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- ADMIN DASHBOARD -->
    <!-- ===================================================== -->

    <record id="admin_dashboard_record"
            model="hospital.admin.dashboard">

        <field name="name">Admin Dashboard</field>

    </record>


    <record id="view_hospital_admin_dashboard_form"
            model="ir.ui.view">

        <field name="name">hospital.admin.dashboard.form</field>
        <field name="model">hospital.admin.dashboard</field>

        <field name="arch" type="xml">

            <form create="0" edit="0" delete="0">

                <sheet>

                    <div class="admin-dashboard">

                        <div class="admin-section">

                            <div class="admin-section-heading">
                                User Summary
                            </div>

                            <div class="admin-stat-grid">

                                <div class="admin-stat-card">
                                    <div class="admin-stat-label">
                                        Total Users
                                    </div>

                                    <div class="admin-stat-number">
                                        <field name="total_users" nolabel="1"/>
                                    </div>
                                </div>


                                <div class="admin-stat-card">
                                    <div class="admin-stat-label">
                                        Active Users
                                    </div>

                                    <div class="admin-stat-number">
                                        <field name="active_users" nolabel="1"/>
                                    </div>
                                </div>


                                <div class="admin-stat-card">
                                    <div class="admin-stat-label">
                                        Inactive Users
                                    </div>

                                    <div class="admin-stat-number">
                                        <field name="inactive_users" nolabel="1"/>
                                    </div>
                                </div>

                            </div>

                        </div>


                        <div class="admin-section">

                            <div class="admin-section-heading">
                                Staff Summary
                            </div>

                            <div class="admin-stat-grid">

                                <div class="admin-stat-card">
                                    <div class="admin-stat-label">
                                        Super Admins
                                    </div>

                                    <div class="admin-stat-number">
                                        <field name="super_admin_count" nolabel="1"/>
                                    </div>
                                </div>


                                <div class="admin-stat-card">
                                    <div class="admin-stat-label">
                                        Doctors
                                    </div>

                                    <div class="admin-stat-number">
                                        <field name="doctor_count" nolabel="1"/>
                                    </div>
                                </div>


                                <div class="admin-stat-card">
                                    <div class="admin-stat-label">
                                        Receptionists
                                    </div>

                                    <div class="admin-stat-number">
                                        <field name="receptionist_count" nolabel="1"/>
                                    </div>
                                </div>

                            </div>

                        </div>


                        <div class="admin-section">

                            <div class="admin-section-heading">
                                Hospital Summary
                            </div>

                            <div class="admin-stat-grid">

                                <div class="admin-stat-card">
                                    <div class="admin-stat-label">
                                        Total Patients
                                    </div>

                                    <div class="admin-stat-number">
                                        <field name="patient_count" nolabel="1"/>
                                    </div>
                                </div>


                                <div class="admin-stat-card">
                                    <div class="admin-stat-label">
                                        Total Appointments
                                    </div>

                                    <div class="admin-stat-number">
                                        <field name="appointment_count" nolabel="1"/>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </sheet>

            </form>
        </field>

    </record>


    <record id="action_hospital_dashboard_admin"
            model="ir.actions.act_window">

        <field name="name">Admin Dashboard</field>

        <field name="res_model">hospital.admin.dashboard</field>

        <field name="view_mode">form</field>

        <field name="res_id"
               ref="admin_dashboard_record"/>

        <field name="target">current</field>

    </record>


    <!-- ===================================================== -->
    <!-- DOCTOR DASHBOARD -->
    <!-- ===================================================== -->

    <record id="doctor_dashboard_record"
            model="hospital.doctor.dashboard">

        <field name="name">Doctor Dashboard</field>

    </record>


    <record id="view_hospital_doctor_dashboard_form"
            model="ir.ui.view">

        <field name="name">hospital.doctor.dashboard.form</field>
        <field name="model">hospital.doctor.dashboard</field>

        <field name="arch" type="xml">

            <form create="0" edit="0" delete="0">

                <sheet>

                    <h1>Doctor Dashboard</h1>

                    <group>

                        <field name="my_appointments"/>

                        <field name="today_appointments"/>

                        <field name="completed_appointments"/>

                        <field name="pending_appointments"/>

                        <field name="my_patients"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <record id="action_hospital_dashboard_doctor"
            model="ir.actions.act_window">

        <field name="name">Doctor Dashboard</field>

        <field name="res_model">hospital.doctor.dashboard</field>

        <field name="view_mode">form</field>

        <field name="res_id"
               ref="doctor_dashboard_record"/>

        <field name="target">current</field>

    </record>


    <!-- ===================================================== -->
    <!-- RECEPTION DASHBOARD - QUICK NAVIGATION ACTIONS -->
    <!-- ===================================================== -->

    <record id="action_hospital_appointment_today" model="ir.actions.act_window">
        <field name="name">Today's Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('appointment_date','=', context_today())]</field>
    </record>

    <record id="action_hospital_appointment_booked" model="ir.actions.act_window">
        <field name="name">Booked Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','booked')]</field>
    </record>

    <record id="action_hospital_appointment_completed" model="ir.actions.act_window">
        <field name="name">Completed Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','completed')]</field>
    </record>

    <record id="action_hospital_appointment_waiting" model="ir.actions.act_window">
        <field name="name">Waiting Patients</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','booked')]</field>
    </record>

    <record id="action_hospital_appointment_pending_payment" model="ir.actions.act_window">
        <field name="name">Pending Payments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_status','=','pending')]</field>
    </record>

    <record id="action_hospital_appointment_cancelled" model="ir.actions.act_window">
        <field name="name">Cancelled Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','cancelled')]</field>
    </record>

    <!--
    TEMPORARILY DISABLED - "hospital.doctor" model exist agala.
    Exact doctor model name confirm panniya piragu ithai enable pannuvom.
    Athuvaraikkum, dashboard-ல doctor cards non-clickable div-ah irukum.

    <record id="action_hospital_doctor_inactive" model="ir.actions.act_window">
        <field name="name">Inactive Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active','=',False)]</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="action_hospital_doctor_available" model="ir.actions.act_window">
        <field name="name">Available Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active','=',True)]</field>
    </record>
    -->


    <!-- ===================================================== -->
    <!-- RECEPTION DASHBOARD (UNIQUE CLICKABLE CARD UI) -->
    <!-- ===================================================== -->

    <record id="reception_dashboard_record"
            model="hospital.reception.dashboard">

        <field name="name">Reception Dashboard</field>

    </record>


    <record id="view_hospital_reception_dashboard_form"
        model="ir.ui.view">

        <field name="name">hospital.reception.dashboard.form</field>
        <field name="model">hospital.reception.dashboard</field>

        <field name="arch" type="xml">

            <form create="0" edit="0" delete="0">

                <sheet>

                    <div class="admin-dashboard">

                        <!-- ===================================== -->
                        <!-- TODAY'S SUMMARY -->
                        <!-- ===================================== -->

                        <div class="admin-section">

                            <div class="admin-section-heading">
                                Today's Summary
                            </div>

                            <div class="admin-stat-grid">

                                <button name="%(action_hospital_patient)d"
                                        type="action"
                                        class="admin-stat-card-btn"
                                        context="{}">
                                    <div class="admin-stat-label">
                                        Total Patients
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="total_patients"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </button>


                                <button name="%(action_hospital_appointment_today)d"
                                        type="action"
                                        class="admin-stat-card-btn"
                                        context="{}">
                                    <div class="admin-stat-label">
                                        Today Appointments
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="today_appointments"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </button>


                                <button name="%(action_hospital_appointment_booked)d"
                                        type="action"
                                        class="admin-stat-card-btn"
                                        context="{}">
                                    <div class="admin-stat-label">
                                        Booked
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="booked_appointments"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </button>


                                <button name="%(action_hospital_appointment_completed)d"
                                        type="action"
                                        class="admin-stat-card-btn"
                                        context="{}">
                                    <div class="admin-stat-label">
                                        Completed
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="completed_appointments"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </button>

                            </div>

                        </div>


                        <!-- ===================================== -->
                        <!-- APPOINTMENT STATUS -->
                        <!-- ===================================== -->

                        <div class="admin-section">

                            <div class="admin-section-heading">
                                Appointment Status
                            </div>

                            <div class="admin-stat-grid">

                                <button name="%(action_hospital_appointment_waiting)d"
                                        type="action"
                                        class="admin-stat-card-btn"
                                        context="{}">
                                    <div class="admin-stat-label">
                                        Waiting
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="waiting_patients"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </button>


                                <button name="%(action_hospital_appointment_pending_payment)d"
                                        type="action"
                                        class="admin-stat-card-btn"
                                        context="{}">
                                    <div class="admin-stat-label">
                                        Pending Payments
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="pending_payments"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </button>


                                <button name="%(action_hospital_appointment_cancelled)d"
                                        type="action"
                                        class="admin-stat-card-btn"
                                        context="{}">
                                    <div class="admin-stat-label">
                                        Cancelled
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="cancelled_appointments"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </button>

                            </div>

                        </div>


                        <!-- ===================================== -->
                        <!-- RECEPTION INFORMATION -->
                        <!-- ===================================== -->

                        <div class="admin-section">

                            <div class="admin-section-heading">
                                Reception Information
                            </div>

                            <div class="admin-stat-grid">

                                <button name="%(action_hospital_patient)d"
                                        type="action"
                                        class="admin-stat-card-btn"
                                        context="{}">
                                    <div class="admin-stat-label">
                                        Registered Patients
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="total_patients"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </button>


                                <!-- Doctor model confirm agura varaikkum non-clickable -->
                                <div class="admin-stat-card-btn" style="cursor:default;">
                                    <div class="admin-stat-label">
                                        Inactive Doctors
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="inactive_doctors"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </div>


                                <button name="%(action_hospital_appointment)d"
                                        type="action"
                                        class="admin-stat-card-btn"
                                        context="{}">
                                    <div class="admin-stat-label">
                                        Total Appointments
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="total_appointments"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </button>

                            </div>

                        </div>


                        <!-- ===================================== -->
                        <!-- DOCTORS -->
                        <!-- ===================================== -->

                        <div class="admin-section">

                            <div class="admin-section-heading">
                                Doctors
                            </div>

                            <div class="admin-stat-grid">

                                <!-- Doctor model confirm agura varaikkum non-clickable -->
                                <div class="admin-stat-card-btn" style="cursor:default;">
                                    <div class="admin-stat-label">
                                        Available Doctors
                                    </div>
                                    <div class="admin-stat-number">
                                        <field name="available_doctors"
                                               nolabel="1" readonly="1"/>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </sheet>

            </form>

        </field>

    </record>

    <record id="action_hospital_dashboard_receptionist"
            model="ir.actions.act_window">

        <field name="name">Reception Dashboard</field>

        <field name="res_model">hospital.reception.dashboard</field>

        <field name="view_mode">form</field>

        <field name="res_id"
            ref="reception_dashboard_record"/>

        <field name="target">current</field>

    </record>
</odoo>